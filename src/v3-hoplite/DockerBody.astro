<script>
  // Section 2: Interactive Audit Defense step highlighting
  const era = document.querySelector<HTMLElement>('[data-dk-era]');
  if (era) {
    const steps = [...era.querySelectorAll<HTMLElement>('[data-era-step]')];
    const cards = [...era.querySelectorAll<HTMLElement>('[data-era-card]')];
    const setEra = (idx: string) => {
      steps.forEach((s) => s.classList.toggle('is-on', s.dataset.eraStep === idx));
      cards.forEach((c) => c.classList.toggle('is-hl', c.dataset.eraCard === idx));
    };
    steps.forEach((s) => {
      s.addEventListener('click', () => setEra(s.dataset.eraStep!));
      s.addEventListener('mouseenter', () => setEra(s.dataset.eraStep!));
    });
  }

  // Section 4: Segmented store count + live ROI savings calculator
  const storesGroup = document.querySelector<HTMLElement>('[data-dk-stores]');
  const calc = document.querySelector<HTMLElement>('[data-dk-calc]');
  if (storesGroup && calc) {
    const storeBtns = [...storesGroup.querySelectorAll<HTMLButtonElement>('[data-stores]')];
    const slider = calc.querySelector<HTMLInputElement>('[data-dk-slider]')!;
    const rxEl = calc.querySelector<HTMLElement>('[data-dk-rxval]')!;
    const riskEl = calc.querySelector<HTMLElement>('[data-dk-risk]')!;
    const subEl = calc.querySelector<HTMLElement>('[data-dk-sub]')!;

    let stores = 1;
    const update = () => {
      const rx = Number(slider.value);
      const annualRisk = Math.round(rx * 0.035 * 175 * 1.2 * stores);
      const monthlySub = 350 * stores;
      rxEl.textContent = `${rx.toLocaleString('en-US')} Rx`;
      riskEl.textContent = `$${annualRisk.toLocaleString('en-US')} / yr`;
      subEl.textContent = `$${monthlySub.toLocaleString('en-US')} / mo`;
    };
    storeBtns.forEach((b) => {
      b.addEventListener('click', () => {
        stores = Number(b.dataset.stores || '1');
        storeBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        update();
      });
    });
    slider.addEventListener('input', update);
    update();
  }

  // Section 5: Horizontal rail prev/next arrows
  const rail = document.querySelector<HTMLElement>('[data-dk-rail]');
  const prev = document.querySelector<HTMLButtonElement>('[data-dk-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-dk-next]');
  if (rail && prev && next) {
    prev.addEventListener('click', () => rail.scrollBy({ left: -388, behavior: 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: 388, behavior: 'smooth' }));
  }

  // Section 6: Demo request form
  const form = document.querySelector<HTMLFormElement>('[data-dk-form]');
  if (form) {
    const msg = form.querySelector<HTMLElement>('[data-dk-fmsg]')!;
    const endpoint = form.dataset.endpoint || '';
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const reqs = [...form.querySelectorAll<HTMLInputElement>('input[required]')];
      let ok = true;
      reqs.forEach((inp) => {
        const valid = inp.checkValidity() && inp.value.trim().length > 0;
        inp.classList.toggle('is-err', !valid);
        if (!valid) ok = false;
      });
      if (!ok) {
        msg.classList.add('is-err');
        msg.textContent = 'Please complete all required fields.';
        return;
      }
      msg.classList.remove('is-err');
      const data = Object.fromEntries(new FormData(form).entries());
      if (endpoint) {
        msg.textContent = 'Sending request…';
        try {
          const r = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          if (!r.ok) throw new Error('err');
          form.reset();
          msg.textContent = 'Thank you — a BatchRx specialist will reach out within one business day.';
        } catch {
          msg.classList.add('is-err');
          msg.textContent = 'Could not send right now. Please try again or visit batchrx.com.';
        }
      } else {
        form.reset();
        msg.textContent = `Demo request received for ${data.pharmacyName}. Our audit team will reach out shortly.`;
      }
    });
  }
</script>
