      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path class="hk-hn__burger-a" d="M4 8H20"></path>
        <path class="hk-hn__burger-b" d="M4 16H20"></path>
      </svg>
    </button>

    <div id="hk-mobile-drawer" class="hk-hnm" inert data-hk-drawer>
      <div class="hk-hnm__scroll">
        <ul class="hk-hnm__list">
          <li>
            <button type="button" class="hk-hnm__row" aria-expanded="false" data-hk-mgroup="0">
              Platform
              <svg class="hk-hn__chevron" viewBox="0 0 8 8" width="8" height="8" aria-hidden="true">
                <path d="M1 2.5L4 5.5L7 2.5"></path>
              </svg>
            </button>
            <div class="hk-hnm__group" data-hk-mpanel="0" inert>
              <ul>
                {
                  [...platformReconcile, ...platformDefense].map((item) => (
                    <li>
                      <a class="hk-hnm__item" href={item.href}>
                        <svg class="hk-nav-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                          <path d={item.icon}></path>
                        </svg>
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </li>

          <li>
            <button type="button" class="hk-hnm__row" aria-expanded="false" data-hk-mgroup="1">
              Audits
              <svg class="hk-hn__chevron" viewBox="0 0 8 8" width="8" height="8" aria-hidden="true">
                <path d="M1 2.5L4 5.5L7 2.5"></path>
              </svg>
            </button>
            <div class="hk-hnm__group" data-hk-mpanel="1" inert>
              <ul>
                {
                  auditCases.map((item) => (
                    <li>
                      <a class="hk-hnm__item" href={item.href}>
                        <svg class="hk-nav-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                          <path d={item.icon}></path>
                        </svg>
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </li>

          <li>
            <button type="button" class="hk-hnm__row" aria-expanded="false" data-hk-mgroup="2">
              Resources
              <svg class="hk-hn__chevron" viewBox="0 0 8 8" width="8" height="8" aria-hidden="true">
                <path d="M1 2.5L4 5.5L7 2.5"></path>
              </svg>
            </button>
            <div class="hk-hnm__group" data-hk-mpanel="2" inert>
              <ul>
                {
                  [...resourcesLearn, ...resourcesCompany].map((item) => (
                    <li>
                      <a class="hk-hnm__item" href={item.href}>
                        <svg class="hk-nav-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                          <path d={item.icon}></path>
                        </svg>
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </li>

          <li>
            <a class="hk-hnm__row" href="#plan">Pricing</a>
          </li>
        </ul>
      </div>

      <div class="hk-hnm__actions">
        <a class="hk-btn hk-btn--line" href={site.loginUrl}>Sign in</a>
        <a class="hk-btn hk-btn--primary" href="#demo">Book a demo</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-hk-header]');
  if (header) {
    // Scroll state (exact Hoplite data-scrolled ground veil)
    const onScroll = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 4);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Desktop Mega-Dropdown (hover + click + smooth sheet height & sliding panels)
    const nav = header.querySelector<HTMLElement>('[data-hk-nav]');
    const sheet = header.querySelector<HTMLElement>('[data-hk-sheet]');
    const triggers = [...header.querySelectorAll<HTMLButtonElement>('[data-hk-trigger]')];
    const panels = [...header.querySelectorAll<HTMLElement>('[data-hk-panel]')];

    let activeIdx = -1;
    let closeTimer: number | undefined;

    const clearClose = () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }
    };

    const setActive = (nextIdx: number) => {
      clearClose();
      const prevIdx = activeIdx;
      activeIdx = nextIdx;
      const isOpen = nextIdx >= 0;

      header.toggleAttribute('data-open', isOpen);

      triggers.forEach((btn, i) => {
        btn.setAttribute('aria-expanded', String(i === nextIdx));
      });

      panels.forEach((panel, i) => {
        if (i === nextIdx) {
          panel.removeAttribute('inert');
          panel.dataset.pos = 'open';
        } else {
          panel.setAttribute('inert', '');
          if (isOpen) {
            panel.dataset.pos = i < nextIdx ? 'before' : 'after';
          } else {
            panel.dataset.pos = 'rest';
          }
        }
      });

      if (sheet) {
        if (isOpen) {
          const h = panels[nextIdx]?.offsetHeight || 0;
          sheet.toggleAttribute('data-switching', prevIdx >= 0 && prevIdx !== nextIdx);
          sheet.style.height = `${h}px`;
          sheet.setAttribute('data-open', '');
        } else {
          sheet.removeAttribute('data-open');
          sheet.removeAttribute('data-switching');
          sheet.style.height = '0px';
        }
      }
    };

    const scheduleClose = () => {
      clearClose();
      closeTimer = window.setTimeout(() => setActive(-1), 150);
    };

    triggers.forEach((btn, i) => {
      btn.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          setActive(i);
        }
      });
      btn.addEventListener('click', () => {
        setActive(activeIdx === i ? -1 : i);
      });
    });

    panels.forEach((panel) => {
      panel.addEventListener('mouseenter', clearClose);
      panel.addEventListener('mouseleave', scheduleClose);
      panel.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setActive(-1));
      });
    });

    nav?.addEventListener('mouseleave', scheduleClose);
    nav?.addEventListener('mouseenter', clearClose);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (activeIdx >= 0) setActive(-1);
        setDrawer(false);
      }
    });

    document.addEventListener('click', (e) => {
      if (activeIdx >= 0 && !header.contains(e.target as Node)) {
        setActive(-1);
      }
    });

    // Mobile drawer + accordions
    const burger = header.querySelector<HTMLButtonElement>('[data-hk-burger]');
    const drawer = header.querySelector<HTMLElement>('[data-hk-drawer]');

    const setDrawer = (open: boolean) => {
      if (!burger || !drawer) return;
      burger.setAttribute('aria-expanded', String(open));
      drawer.toggleAttribute('data-open', open);
      if (open) {
        drawer.removeAttribute('inert');
        document.documentElement.style.overflow = 'hidden';
      } else {
        drawer.setAttribute('inert', '');
        document.documentElement.style.overflow = '';
      }
    };

    burger?.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') !== 'true';
      setDrawer(open);
    });

    drawer?.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setDrawer(false));
    });

    const mTriggers = [...header.querySelectorAll<HTMLButtonElement>('[data-hk-mgroup]')];
    mTriggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = btn.dataset.hkMgroup;
        const panel = header.querySelector<HTMLElement>(`[data-hk-mpanel="${idx}"]`);
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!isOpen));
        if (panel) {
          panel.toggleAttribute('data-open', !isOpen);
          if (!isOpen) panel.removeAttribute('inert');
          else panel.setAttribute('inert', '');
        }
      });
    });
  }
</script>
