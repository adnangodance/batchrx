      <div class="hk-hn__sheet" aria-hidden="true" style="height:0" data-hk-sheet></div>
    </nav>

    <div class="hk-hn__actions">
      <a class="hk-hn__top hk-hn__signin" href={site.loginUrl}>Sign in</a>
      <span class="hk-hn__ring">
        <a class="hk-btn hk-btn--primary hk-btn--s" href="#demo">Book a demo</a>
