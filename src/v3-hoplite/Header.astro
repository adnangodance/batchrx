                </ul>
              </div>

              <div class="hk-hn__feature">
                <a class="hk-hn__card" href="#plan">
                  <span class="hk-hn__art" aria-hidden="true">
                    <canvas data-hk-glass data-flute="0" data-strip-scale="1"></canvas>
                  </span>
                  <span class="hk-hn__item-label">One-on-one specialist defense</span>
                  <span class="hk-hn__item-body">Every pharmacy gets a dedicated specialist through every audit.</span>
                </a>
              </div>
            </div>
          </div>
        </li>

        <li>
          <button
            type="button"
            class="hk-hn__top hk-hn__trigger"
            aria-expanded="false"
            aria-controls="hk-panel-1"
            data-hk-trigger="1"
