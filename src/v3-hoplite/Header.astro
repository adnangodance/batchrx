---

<header class="hk-header" data-hk-header>
  <span class="hk-header__ground" aria-hidden="true"></span>
  <div class="hk-wrap hk-header__inner">
    <a class="hk-header__home" href={`${base}${home}`} aria-label="BatchRx home" aria-current="page">
      <svg class="hk-header__mark" viewBox="0 0 27.7279 27.7279" width="24" height="24" aria-hidden="true">
        <path d={LOGO}></path>
      </svg>
      <span>BatchRx</span>
    </a>

    <nav class="hk-hn" aria-label="Primary" data-hk-nav>
      <ul class="hk-hn__list">
        <li>
          <button
            type="button"
            class="hk-hn__top hk-hn__trigger"
            aria-expanded="false"
            aria-controls="hk-panel-0"
            data-hk-trigger="0"
          >
            Platform
            <svg class="hk-hn__chevron" viewBox="0 0 8 8" width="8" height="8" aria-hidden="true">
              <path d="M1 2.5L4 5.5L7 2.5"></path>
            </svg>
          </button>
          <div id="hk-panel-0" class="hk-hn__panel" data-pos="rest" data-hk-panel="0" inert>
            <div class="hk-wrap hk-hn__inner">
              <div class="hk-hn__group">
                <p class="hk-label hk-hn__heading">Reconcile</p>
                <ul>
                  {
                    platformReconcile.map((item) => (
                      <li>
                        <a class="hk-hn__item" href={item.href}>
                          <svg class="hk-nav-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                            <path d={item.icon}></path>
                          </svg>
                          <span class="hk-hn__item-text">
                            <span class="hk-hn__item-label">{item.label}</span>
                            <span class="hk-hn__item-body">{item.body}</span>
                          </span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div class="hk-hn__group">
                <p class="hk-label hk-hn__heading">Audit defense</p>
                <ul>
                  {
                    platformDefense.map((item) => (
                      <li>
                        <a class="hk-hn__item" href={item.href}>
                          <svg class="hk-nav-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                            <path d={item.icon}></path>
                          </svg>
                          <span class="hk-hn__item-text">
                            <span class="hk-hn__item-label">{item.label}</span>
                            <span class="hk-hn__item-body">{item.body}</span>
                          </span>
                        </a>
                      </li>
                    ))
