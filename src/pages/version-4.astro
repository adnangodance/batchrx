    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---------- 1. Split-letter masked slide-up headings (Trustly letters-slide-up) ---------- */
      const splitIntoLetters = (el: HTMLElement) => {
        const text = (el.textContent ?? '').trim().replace(/\s+/g, ' ');
        el.setAttribute('aria-label', text);
        el.textContent = '';
        let charIdx = 0;
        const words = text.split(' ');
        words.forEach((word, wi) => {
          const wSpan = document.createElement('span');
          wSpan.className = 'sp-word';
          wSpan.setAttribute('aria-hidden', 'true');
          for (const ch of word) {
            const cSpan = document.createElement('span');
            cSpan.className = 'sp-char';
            cSpan.textContent = ch;
            cSpan.style.setProperty('--cd', `${Math.min(charIdx * 16, 460)}ms`);
            wSpan.appendChild(cSpan);
            charIdx++;
          }
          el.appendChild(wSpan);
          if (wi < words.length - 1) el.appendChild(document.createTextNode(' '));
        });
      };

      const splitEls = [...document.querySelectorAll<HTMLElement>('[data-split-letters]')];
      splitEls.forEach(splitIntoLetters);

      if (reduce) {
        splitEls.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const splitIO = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                splitIO.unobserve(entry.target);
              }
            }),
          { rootMargin: '0px 0px -10% 0px' },
        );
        splitEls.forEach((el) => splitIO.observe(el));
      }

      /* ---------- 2. Scroll-scrubbed word-by-word illumination (Trustly scrub-each-word) ---------- */
      const scrubEl = document.querySelector<HTMLElement>('[data-scrub-words]');
      let scrubWords: HTMLElement[] = [];
      if (scrubEl) {
        const txt = (scrubEl.textContent ?? '').trim().replace(/\s+/g, ' ');
        scrubEl.textContent = '';
        txt.split(' ').forEach((w, i, arr) => {
          const s = document.createElement('span');
          s.className = 'sw';
          s.textContent = w + (i < arr.length - 1 ? ' ' : '');
          scrubEl.appendChild(s);
          scrubWords.push(s);
        });
      }

      /* ---------- 3. Generic scroll reveal (.rv) ---------- */
      if (reduce) {
        document.querySelectorAll('.rv').forEach((el) => el.classList.add('in'));
      } else {
        const rvIO = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                rvIO.unobserve(entry.target);
              }
            }),
          { rootMargin: '0px 0px -6% 0px' },
        );
        document.querySelectorAll('.rv').forEach((el) => rvIO.observe(el));
      }

      /* ---------- 4. Unified 60fps Scroll Engine (Hero 3D Untilt + Scrub Words + A2A Parallax + Expanding Width Cards) ---------- */
      const heroTilt = document.querySelector<HTMLElement>('[data-hero-tilt]');
      const heroPar = document.querySelector<HTMLElement>('[data-hero-parallax]');
      const a2aSec = document.querySelector<HTMLElement>('[data-a2a]');
      const a2aBg = document.querySelector<HTMLElement>('[data-a2a-bg]');
      const widthStage = document.querySelector<HTMLElement>('[data-width-stage]');
      const widthRow = document.querySelector<HTMLElement>('[data-width-row]');

      if (!reduce) {
        let ticking = false;
        const updateScrollEffects = () => {
          ticking = false;
          const vh = window.innerHeight;

          // Hero 3D perspective scroll untilt
          if (heroTilt && window.innerWidth >= 900) {
            const rect = heroTilt.getBoundingClientRect();
            const progress = Math.max(0, Math.min(1, (vh * 0.92 - rect.top) / (vh * 0.65)));
            const rx = (1 - progress) * 8.5;
            const sc = 0.955 + progress * 0.045;
            heroTilt.style.transform = `perspective(1800px) rotateX(${rx.toFixed(2)}deg) scale(${sc.toFixed(4)})`;
            if (heroPar) {
              const py = (1 - progress) * 18;
              heroPar.style.transform = `translate3d(0, ${py.toFixed(1)}px, 0)`;
            }
          } else if (heroTilt) {
            heroTilt.style.transform = '';
          }

          // Scrub-each-word illumination
          if (scrubEl && scrubWords.length) {
            const rect = scrubEl.getBoundingClientRect();
            const start = vh * 0.9;
            const end = vh * 0.34;
            const prog = Math.max(0, Math.min(1, (start - rect.top) / (start - end)));
            const total = scrubWords.length;
            scrubWords.forEach((w, idx) => {
              const threshold = idx / total;
              const local = Math.max(0, Math.min(1, (prog - threshold) * 10));
              w.style.opacity = (0.18 + local * 0.82).toFixed(2);
            });
          }

          // A2A background subtle parallax
          if (a2aSec && a2aBg) {
            const rect = a2aSec.getBoundingClientRect();
            if (rect.bottom > 0 && rect.top < vh) {
              const norm = (rect.top + rect.height / 2 - vh / 2) / vh;
              a2aBg.style.transform = `translate3d(0, ${(norm * -42).toFixed(1)}px, 0)`;
            }
          }

          // Expanding 3-card width animation (center starts wide, opens out to 3 equal cards)
          if (widthStage && widthRow && window.innerWidth >= 1080) {
            const rect = widthStage.getBoundingClientRect();
            const p = Math.max(0, Math.min(1, (vh * 0.85 - rect.top) / (vh * 0.58)));
            widthRow.style.setProperty('--p', p.toFixed(3));
          }
        };

        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(updateScrollEffects);
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        updateScrollEffects();
      } else if (widthRow) {
        widthRow.style.setProperty('--p', '1');
      }

      /* ---------- 5. Pointer-tracking emerald spotlight on glassmorphic A2A cards ---------- */
      document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      /* ---------- 6. Signature Trustly Expanding Circle-Arrow Buttons ---------- */
      document.querySelectorAll<HTMLElement>('.has-circle-hover').forEach((card) => {
        const btn = card.querySelector<HTMLElement>('[data-circle-btn]');
        const txt = btn?.querySelector<HTMLElement>('.circle-arrow-txt');
        const svg = btn?.querySelector<HTMLElement>('.circle-arrow-svg');
        if (!btn || !txt || !svg) return;
        const expand = () => {
          if (window.innerWidth < 768) return;
          btn.style.width = `${txt.offsetWidth + svg.offsetWidth + 4}px`;
        };
        const collapse = () => {
          btn.style.width = '2.5rem';
        };
        card.addEventListener('mouseenter', expand);
        card.addEventListener('mouseleave', collapse);
        card.addEventListener('focusin', expand);
        card.addEventListener('focusout', collapse);
      });

      /* ---------- 7. Navbar Mega-Dropdown Blur + Mobile Drawer + Mode Switcher ---------- */
      const navBlur = document.querySelector<HTMLElement>('[data-nav-blur]');
      document.querySelectorAll<HTMLElement>('[data-nav-dd]').forEach((dd) => {
        dd.addEventListener('mouseenter', () => navBlur?.classList.add('is-on'));
        dd.addEventListener('mouseleave', () => navBlur?.classList.remove('is-on'));
      });

      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
      const mobileNav = nav.querySelector<HTMLElement>('[data-mobile-nav]')!;
      const setMenu = (open: boolean) => {
        mobileNav.hidden = !open;
        nav.classList.toggle('is-open', open);
        burger.setAttribute('aria-expanded', String(open));
      };
      burger.addEventListener('click', () => setMenu(mobileNav.hasAttribute('hidden')));
      mobileNav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      const modeSwitch = document.querySelector<HTMLElement>('[data-mode-switch]');
      const modeTitle = document.querySelector<HTMLElement>('[data-mode-title]');
      const modeSub = document.querySelector<HTMLElement>('[data-mode-sub]');
      if (modeSwitch && modeTitle && modeSub) {
        const btns = [...modeSwitch.querySelectorAll<HTMLButtonElement>('[data-mode]')];
        const copy = {
          single: {
            title: 'Smart growth with smarter audits',
            sub: 'Prevent recoupments, catch invoice shortages early, and defend every PBM audit—with continuous NDC reconciliation and a dedicated specialist for $350/month.',
          },
          multi: {
            title: 'One screen for every pharmacy store',
            sub: 'Oversee monthly reconciliation rates, wholesaler shortages, and active PBM audits across 2 to 12+ locations—backed by dedicated specialists for every store.',
          },
        };
        btns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = btn.dataset.mode as 'single' | 'multi';
            btns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
            modeTitle.classList.remove('is-revealed');
            modeTitle.textContent = copy[key].title;
            splitIntoLetters(modeTitle);
            requestAnimationFrame(() => modeTitle.classList.add('is-revealed'));
            modeSub.textContent = copy[key].sub;
          });
        });
      }

      /* ---------- 8. Hero Payer Tabs ---------- */
      const stage = document.querySelector<HTMLElement>('[data-payer-stage]');
      if (stage) {
        const tabs = [...stage.querySelectorAll<HTMLButtonElement>('[data-ptab]')];
        const panels = [...stage.querySelectorAll<HTMLElement>('[data-ppanel]')];
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const id = tab.dataset.ptab!;
            tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
            panels.forEach((p) => {
              p.hidden = p.dataset.ppanel !== id;
            });
          });
        });
      }

      /* ---------- 9. Count-up numbers on Scale Width Cards ---------- */
      const cntIO = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            cntIO.unobserve(entry.target);
            if (reduce) return;
            const el = entry.target as HTMLElement;
            const end = Number(el.dataset.cnt);
            const t0 = performance.now();
            const step = (t: number) => {
              const p = Math.min(1, (t - t0) / 1400);
              const val = Math.round(end * (1 - Math.pow(1 - p, 4)));
              el.textContent = val.toLocaleString('en-US');
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }),
        { threshold: 0.45 },
      );
      document.querySelectorAll<HTMLElement>('[data-cnt]').forEach((el) => cntIO.observe(el));

      /* ---------- 10. Auto-Advancing 4-Step Speed Walkthrough (Trustly script 11) ---------- */
      const speed = document.querySelector<HTMLElement>('[data-speed]');
      const speedList = document.querySelector<HTMLElement>('[data-speed-list]');
      if (speed && speedList) {
        const sBtns = [...speed.querySelectorAll<HTMLButtonElement>('[data-step-btn]')];
        const sPanels = [...speed.querySelectorAll<HTMLElement>('[data-step-panel]')];
        let cur = 0;
        let timer = 0;
        let inView = false;

        const activate = (idx: number) => {
          cur = (idx + sBtns.length) % sBtns.length;
          sBtns.forEach((b, i) => {
            const active = i === cur;
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', String(active));
            if (active) {
              // force reflow so progress bar restarts cleanly
              void b.offsetWidth;
              b.classList.add('is-active');
            }
          });
          sPanels.forEach((p, i) => p.classList.toggle('is-active', i === cur));
        };

        const startAuto = () => {
          clearInterval(timer);
          if (!reduce && inView) {
            speedList.classList.remove('is-paused');
            timer = window.setInterval(() => activate(cur + 1), 5000);
          }
        };
        const stopAuto = () => {
          clearInterval(timer);
          speedList.classList.add('is-paused');
        };

        sBtns.forEach((b, i) => {
          b.addEventListener('click', () => {
            activate(i);
            startAuto();
          });
          b.addEventListener('mouseenter', stopAuto);
          b.addEventListener('mouseleave', startAuto);
          b.addEventListener('focus', stopAuto);
          b.addEventListener('blur', startAuto);
        });

        const spIO = new IntersectionObserver(
          ([entry]) => {
            inView = entry.isIntersecting;
            if (inView) {
              activate(cur);
              startAuto();
            } else {
              stopAuto();
            }
          },
          { threshold: 0.35 },
        );
        spIO.observe(speed);
      }

      /* ---------- 11. Case Studies Bento Carousel (Elastic Pagination) ---------- */
      const cases = document.querySelector<HTMLElement>('[data-cases]');
      if (cases) {
        const slides = [...cases.querySelectorAll<HTMLElement>('[data-cslide]')];
        const dots = [...cases.querySelectorAll<HTMLButtonElement>('[data-cdot]')];
        let ci = 0;
        const go = (n: number) => {
          ci = (n + slides.length) % slides.length;
          slides.forEach((s, i) => s.classList.toggle('is-on', i === ci));
          dots.forEach((d, i) => d.setAttribute('aria-current', String(i === ci)));
        };
        cases.querySelector('[data-cprev]')?.addEventListener('click', () => go(ci - 1));
        cases.querySelector('[data-cnext]')?.addEventListener('click', () => go(ci + 1));
        dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
      }

      /* ---------- 12. Horizontal Audit Deck Scroll Arrows ---------- */
      const ind = document.querySelector<HTMLElement>('[data-ind]');
      const itrack = ind?.querySelector<HTMLElement>('[data-itrack]');
      if (ind && itrack) {
        const stepWidth = () => (itrack.querySelector<HTMLElement>('.ind-card')?.offsetWidth ?? 320) + 24;
        ind.querySelector('[data-iprev]')?.addEventListener('click', () =>
          itrack.scrollBy({ left: -stepWidth(), behavior: 'smooth' }),
        );
        ind.querySelector('[data-inext]')?.addEventListener('click', () =>
          itrack.scrollBy({ left: stepWidth(), behavior: 'smooth' }),
        );
      }

      /* ---------- 13. Security & FAQ Accordion with Crossfading Square Visuals ---------- */
      const acc = document.querySelector<HTMLElement>('[data-acc]');
      if (acc) {
        const items = [...acc.querySelectorAll<HTMLElement>('[data-acc-item]')];
        const btns = [...acc.querySelectorAll<HTMLButtonElement>('[data-acc-btn]')];
        const imgs = [...acc.querySelectorAll<HTMLElement>('[data-acc-img]')];

        const openAcc = (idx: number) => {
          items.forEach((it, i) => it.classList.toggle('is-open', i === idx));
          btns.forEach((b, i) => b.setAttribute('aria-expanded', String(i === idx)));
          imgs.forEach((img, i) => img.classList.toggle('is-on', i === idx));
        };
        btns.forEach((b, i) => b.addEventListener('click', () => openAcc(i)));
      }

      /* ---------- 14. Integrations Chip Filter ---------- */
      const eco = document.querySelector<HTMLElement>('[data-eco]');
      if (eco) {
        const fBtns = [...eco.querySelectorAll<HTMLButtonElement>('[data-ecof]')];
        const chips = [...eco.querySelectorAll<HTMLElement>('[data-ecocat]')];
        fBtns.forEach((b) => {
          b.addEventListener('click', () => {
            const cat = b.dataset.ecof!;
            fBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            chips.forEach((c) => {
              c.hidden = cat !== 'all' && c.dataset.ecocat !== cat;
            });
          });
        });
      }

      /* ---------- 15. Savings Calculator ---------- */
      const calc = document.querySelector<HTMLElement>('[data-calc]');
      if (calc) {
        const input = calc.querySelector<HTMLInputElement>('input')!;
        const out = (k: string) => calc.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
        const update = () => {
          const rx = Number(input.value);
          const disc = rx * 0.035;
          const save = Math.round(disc * 175);
          out('rx').textContent = rx >= 10000 ? '10,000+' : rx.toLocaleString('en-US');
          out('d').textContent = disc.toFixed(1);
          out('s').textContent = '$' + save.toLocaleString('en-US');
          out('x').textContent = Math.max(1, Math.round(save / 350)) + '×';
        };
        input.addEventListener('input', update);
        update();
      }

      /* ---------- 16. Demo Request Form ---------- */
      const form = document.querySelector<HTMLFormElement>('[data-demo-form]');
      if (form) {
        const msg = form.querySelector<HTMLElement>('[data-fmsg]')!;
        const endpoint = form.dataset.endpoint || '';
        form.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          const reqs = [...form.querySelectorAll<HTMLInputElement>('input[required]')];
          let ok = true;
          reqs.forEach((inp) => {
            const valid = inp.checkValidity() && inp.value.trim().length > 0;
            inp.classList.toggle('is-err', !valid);
            if (!valid) ok = false;
          });
          if (!ok) {
            msg.classList.add('is-err');
            msg.textContent = 'Please complete all required fields.';
            return;
          }
          msg.classList.remove('is-err');
          const data = Object.fromEntries(new FormData(form).entries());
          if (endpoint) {
            msg.textContent = 'Sending request…';
            try {
              const r = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
              });
              if (!r.ok) throw new Error('err');
              form.reset();
              msg.textContent = 'Thank you — a BatchRx specialist will reach out within one business day.';
            } catch {
              msg.classList.add('is-err');
              msg.textContent = 'Could not send right now. Please try again or visit batchrx.com.';
            }
          } else {
            form.reset();
            msg.textContent = `Demo request received for ${data.pharmacyName}. Our audit team will reach out shortly.`;
          }
        });
      }
    </script>
  </body>
</html>
