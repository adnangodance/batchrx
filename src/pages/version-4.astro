---

<!doctype html>
<html lang="en" style={texVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BatchRx — Smarter pharmacy audit defense</title>
    <meta
      name="description"
      content="Protect paid pharmacy claims with continuous wholesaler-to-PBM reconciliation and one-on-one specialist audit defense. $350/month, HIPAA compliant, serving all 50 states."
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <div class="nav-blur" data-nav-blur aria-hidden="true"></div>

    <!-- ================= TRUSTLY-STYLE NAVBAR WITH MEGA DROPDOWNS ================= -->
    <header class="navbar" data-nav>
      <div class="wrap navbar__in">
        <div class="navbar__left">
          <a href={`${base}/version-4`} class="brand" aria-label="BatchRx home">
            <span class="brand__mark" aria-hidden="true">
              <svg viewBox="0 0 27.7279 27.7279" width="15" height="15">
                <path d={LOGO} fill="#45ed7d"></path>
              </svg>
            </span>
            <span>BatchRx</span>
          </a>

          <div class="nav-switch" role="group" aria-label="Pharmacy type" data-mode-switch>
            <button type="button" class="nav-switch-btn" aria-pressed="true" data-mode="single">Independent</button>
            <button type="button" class="nav-switch-btn" aria-pressed="false" data-mode="multi">Multi-store</button>
          </div>
        </div>

        <nav class="nav-menu" aria-label="Primary">
          <div class="nav-item" data-nav-dd>
            <button type="button" class="nav-trigger">
              Platform
              <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2.5 4.5 6 8l3.5-3.5"></path></svg>
            </button>
            <div class="nav-dd">
              <a href="#solutions"><b>Inventory report</b><small>Purchased vs. billed for every NDC by payer</small></a>
              <a href="#solutions"><b>PBM report</b><small>See shortage exposure across every PBM</small></a>
              <a href="#solutions"><b>Aberrant claims &amp; BIN search</b><small>Flag outliers before they trigger an audit</small></a>
              <a href="#solutions"><b>BatchRx Defense Engine</b><small>Automated reconciliation + human specialists</small></a>
            </div>
          </div>

          <div class="nav-item" data-nav-dd>
            <button type="button" class="nav-trigger">
              Audits
              <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2.5 4.5 6 8l3.5-3.5"></path></svg>
            </button>
            <div class="nav-dd">
              <a href="#audits"><b>CMS audits</b><small>Medicare reviews guided step by step</small></a>
              <a href="#audits"><b>OnSite audits</b><small>Be prepared before the auditor walks in</small></a>
              <a href="#audits"><b>Desktop audits</b><small>Claims pulled and packets submitted on time</small></a>
              <a href="#audits"><b>Investigative audits</b><small>One-on-one support when stakes are highest</small></a>
            </div>
          </div>

          <a href="#workflow" class="nav-trigger">How it works</a>
          <a href="#cases" class="nav-trigger">Case studies</a>
          <a href="#pricing" class="nav-trigger">Pricing</a>
          <a href="#savings" class="nav-trigger">Savings</a>
        </nav>

        <div class="navbar__right">
          <a href={site.loginUrl} class="nav-login">Log in</a>
          <a href="#demo" class="primary-small-button">
            Contact sales
            <span class="btn-arrow" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
            </span>
          </a>
          <button type="button" class="nav-burger" aria-label="Toggle menu" aria-expanded="false" aria-controls="v4-mnav" data-burger>
            <span></span><span></span>
          </button>
        </div>
      </div>

      <div class="nav-mobile" id="v4-mnav" hidden data-mobile-nav>
        <a href="#solutions">Platform</a>
        <a href="#workflow">How it works</a>
        <a href="#cases">Case studies</a>
        <a href="#audits">Audit types</a>
        <a href="#pricing">Pricing</a>
        <a href="#savings">Savings</a>
        <a href={site.loginUrl}>Log in</a>
        <a href="#demo" class="primary-big-button" style="margin-top:0.65rem">
          Get started
          <span class="btn-arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </span>
        </a>
      </div>
    </header>

    <main id="main">
      <!-- ================= SEC 1: TRUSTLY JUMBO HERO + 3D PERSPECTIVE FRAME ================= -->
      <section class="hero-sec" aria-labelledby="hero-h">
        <div class="wrap">
          <div class="hero-text">
            <h1 id="hero-h" class="jumbo-h" data-split-letters data-mode-title>
              Smart growth with smarter audits
            </h1>
            <p class="text-xl rv" style="--d:.12s" data-mode-sub>
              Prevent recoupments, catch invoice shortages early, and defend every PBM audit—with continuous NDC
              reconciliation and a dedicated specialist for ${site.price}/month.
            </p>
            <div class="hero-actions rv" style="--d:.2s">
              <a href="#demo" class="primary-big-button">
                Get started
                <span class="btn-arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                </span>
              </a>
              <a href="#savings" class="tertiary-small-button">Calculate your savings</a>
            </div>
          </div>

          <!-- Exact Trustly triple-framed container with scroll-driven 3D perspective untilt -->
          <div class="hero-frame-outer" data-hero-tilt>
            <div class="hero-frame-mid">
              <div class="hero-frame-inner" data-payer-stage>
                <div class="hero-stage-grid">
                  <div class="h-glass">
                    <div class="h-bar">
                      <div class="h-tabs" role="tablist" aria-label="PBM reconciliation preview">
                        {
                          payerTabs.map((t, i) => (
                            <button
                              type="button"
                              class="h-tab"
                              role="tab"
                              aria-selected={i === 0 ? 'true' : 'false'}
                              data-ptab={t.id}
                            >
                              {t.label}
                            </button>
                          ))
                        }
                      </div>
                      <span class="h-live mono"><i></i>Live NDC reconciliation</span>
                    </div>

                    {
                      payerTabs.map((t, i) => (
                        <div class="h-panel" data-ppanel={t.id} hidden={i !== 0}>
                          <div class="h-kpis">
                            <div class="h-kpi">
                              <small>Matched accuracy</small>
                              <b class="g tnum">{t.matched}</b>
                            </div>
                            <div class="h-kpi">
                              <small>NDCs reconciled</small>
                              <b class="tnum">{t.ndcs}</b>
                            </div>
                            <div class="h-kpi">
                              <small>Flagged before audit</small>
                              <b class="w tnum">{t.risk}</b>
                            </div>
                          </div>

                          <div class="h-rows">
                            {t.rows.map((r) => (
                              <div class="h-row">
                                <strong>{r.drug}</strong>
                                <span class="mono">Bought {r.bought}</span>
                                <span class="mono">Billed {r.billed}</span>
                                <em class:list={['h-tag', r.bad ? 'h-tag--bad' : 'h-tag--ok']} style="font-style:normal">
                                  {r.status}
                                </em>
                              </div>
                            ))}
                          </div>
                        </div>
                      ))
                    }
                  </div>

                  <aside class="h-float-card" data-hero-parallax aria-label="Dedicated audit specialist">
                    <div class="h-float__top">
                      <div class="h-av">
                        <span class="h-av__dot">AS</span>
                        <div>
                          <b>Your audit specialist</b>
                          <small>Included in $350/mo plan</small>
                        </div>
                      </div>
                      <span class="h-pill-green">Online</span>
                    </div>

                    <div class="h-bubbles">
                      <div class="h-bubble">
                        We caught 2 shortages in your October cycle. I pulled the matching secondary invoices from Real Value.
                      </div>
                      <div class="h-bubble h-bubble--out">
                        Uploaded the delivery signatures—ready for Express Scripts?
                      </div>
                      <div class="h-bubble">
                        All 26 claims are verified and bundled. Ready to submit ahead of deadline.
                      </div>
                    </div>

                    <ul class="h-checks">
                      <li><span>PMS + wholesaler invoices synced</span><em>DONE</em></li>
                      <li><span>Aberrant BIN outliers reviewed</span><em>DONE</em></li>
                      <li><span>Audit response packet verified</span><em>READY</em></li>
                    </ul>
                  </aside>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= SEC 2: LOOPING PAYER MARQUEE ================= -->
      <section class="logo-sec" aria-label="Supported PBMs and payers">
        <div class="wrap">
          <p class="logo-sec__cap">Join 400+ pharmacies defending claims across major PBMs</p>
        </div>
        <div class="marquee" aria-label={payers.join(', ')}>
          <div class="marquee__track" aria-hidden="true">
            {[...payers, ...payers].map((p) => <span class="marquee__pill">{p}</span>)}
          </div>
        </div>
      </section>

      <!-- ================= SEC 3: SCROLL-SCRUBBED EDITORIAL STATEMENT ================= -->
      <section class="scrub-sec">
        <div class="wrap">
          <h2 class="scrub-text" data-scrub-words>
            We are the pharmacy audit defense leader, connecting independent and multi-store pharmacies with continuous
            NDC reconciliation and dedicated specialists—with speed, security and zero hassle.
          </h2>
