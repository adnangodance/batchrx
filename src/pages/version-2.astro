      <!-- ================= PRICING ================= -->
      <section class="wrap rule" id="pricing">
        <div class="ch__head">
          <h2 class="t2 rv">One simple plan<br /><span>for every pharmacy</span></h2>
          <div>
            <p class="t3 rv">Everything you need to pass every audit<br /><span>no tiers, no hidden fees, no surprises</span></p>
          </div>
        </div>
        <div class="panel panel--d wide rv">
          <div class="ui">
            <div class="ui__bar"><span class="ui__brand"><svg viewBox="0 0 27.7279 27.7279" width="13" height="13" aria-hidden="true"><path d={LOGO} fill="currentColor"></path></svg>All-in-One Plan</span><span class="mut">Billed monthly</span></div>
            <div class="plan">
