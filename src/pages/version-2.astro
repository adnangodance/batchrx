        <ul class="chips rv">{pmsSystems.map((p) => <li class="pms">{p}</li>)}</ul>
        <p class="chips__label rv">Primary & secondary wholesalers</p>
        <ul class="chips rv">{wholesalers.map((w) => <li>{w}</li>)}</ul>
        <div class="tri" style="margin-top:48px">
          {
            [
              { n: '1 PMS', ic: 'pms', t: 'Connect your pharmacy system', b: pmsSystems.join(', ') + '.' },
              { n: '2 Wholesalers', ic: 'truck', t: 'Add every supplier', b: 'Kinray, McKesson, AmerisourceBergen and all secondaries.' },
              { n: '3 Specialist', ic: 'specialist', t: 'Meet your specialist', b: 'Your one-on-one audit partner, from your first audit on.' },
            ].map((x) => (
              <a href="#demo" class="step rv">
                <span class="mono">{x.n}</span>
