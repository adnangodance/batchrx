      <!-- ================= WALL ================= -->
      <section class="wrap rule" id="wall">
        <h2 class="t2 rv">Here's what our pharmacies are saying<br /><span>owners and pharmacists across New York</span></h2>
        <div class="wall">
          {
            testimonials.map((t) => (
              <figure class="rv">
