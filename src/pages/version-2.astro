    <!-- ================= FOOTER ================= -->
    <footer class="ft" style="margin-top:120px">
      <div class="wrap ft__grid">
        <div class="ft__brand">
          <span class="brand">
            <svg viewBox="0 0 27.7279 27.7279" width="20" height="20" aria-hidden="true"><path d={LOGO} fill="#d8e5e0"></path></svg>
            BatchRx
          </span>
          <p>Streamline your audit process with an all-in-one tool designed specifically for pharmacies.</p>
        </div>
        <div><h4>Product</h4><a href="#ch-1">Reconcile</a><a href="#ch-2">Savings</a><a href="#ch-3">Audit support</a><a href="#pricing">Pricing</a></div>
        <div><h4>Company</h4><a href="#demo">Book a demo</a><a href="#faq">FAQ</a><a href={site.loginUrl}>Sign in</a></div>
        <div><h4>Versions</h4><a href="/">Version 1</a><a href="/version-2" aria-current="page">Version 2</a></div>
      </div>
      <div class="wrap ft__bot">
        <span>© {year} BatchRx. All rights reserved.</span>
        <span>HIPAA compliant · Serving all 50 states</span>
      </div>
    </footer>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // sticky nav border
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const onScroll = () => nav.classList.toggle('stuck', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // theme toggle: brand green <-> black
      const tbtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!;
      const applyTheme = (black: boolean) => {
        if (black) document.documentElement.dataset.theme = 'black';
        else delete document.documentElement.dataset.theme;
        tbtn.setAttribute('aria-label', black ? 'Switch to brand green theme' : 'Switch to black theme');
        tbtn.setAttribute('aria-pressed', String(black));
        meta.content = black ? '#000000' : '#0b221d';
      };
      applyTheme(document.documentElement.dataset.theme === 'black' || new URLSearchParams(location.search).get('theme') === 'black');
      tbtn.addEventListener('click', () => {
        const black = document.documentElement.dataset.theme !== 'black';
        applyTheme(black);
        try {
          localStorage.setItem('brx-theme', black ? 'black' : 'green');
        } catch (e) {}
      });

      // reveal
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.rv').forEach((el) => io.observe(el));

      // hero: feature tabs switch the product view, auto-advancing
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
      const tabsEl = document.querySelector<HTMLElement>('[data-tabs]')!;
      const viewEls = [...document.querySelectorAll<HTMLElement>('[data-view]')];
      const DUR = 6000;
      tabsEl.style.setProperty('--dur', DUR + 'ms');
      let idx = 0;
      let timer = 0;
      const show = (i: number, user = false) => {
        idx = (i + tabs.length) % tabs.length;
        tabs.forEach((t, j) => t.setAttribute('aria-selected', String(j === idx)));
        viewEls.forEach((v) => v.classList.toggle('on', v.dataset.view === tabs[idx].dataset.tab));
        clearTimeout(timer);
        if (user) tabsEl.classList.add('paused');
        if (!reduce && !user) timer = window.setTimeout(() => show(idx + 1), DUR);
      };
      tabs.forEach((t, j) => t.addEventListener('click', () => show(j, true)));
      if (reduce) tabsEl.classList.add('paused');
      // ?view=pbm|abr|aud|src opens a specific feature view
      const start = tabs.findIndex((t) => t.dataset.tab === new URLSearchParams(location.search).get('view'));
      show(Math.max(0, start), start > 0);

      // count-up stats
      const cio = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (!e.isIntersecting) return;
            cio.unobserve(e.target);
            if (reduce) return;
            const el = e.target as HTMLElement;
            const end = Number(el.dataset.cnt);
            const t0 = performance.now();
            const step = (t: number) => {
              const p = Math.min(1, (t - t0) / 1400);
              el.textContent = Math.round(end * (1 - Math.pow(1 - p, 4))).toLocaleString('en-US');
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }),
        { threshold: 0.6 },
      );
      document.querySelectorAll('[data-cnt]').forEach((el) => cio.observe(el));

      // quote rotator
      const qs = [...document.querySelectorAll<HTMLElement>('[data-quotes] .q')];
      const qb = [...document.querySelectorAll<HTMLButtonElement>('[data-qnav] button')];
      let qi = 0;
      let qt = 0;
      const showQ = (i: number) => {
        qi = (i + qs.length) % qs.length;
        qs.forEach((q, j) => q.classList.toggle('on', j === qi));
        qb.forEach((b, j) => b.setAttribute('aria-current', String(j === qi)));
        clearTimeout(qt);
        if (!reduce) qt = window.setTimeout(() => showQ(qi + 1), 7000);
      };
      qb.forEach((b, j) => b.addEventListener('click', () => showQ(j)));
      showQ(0);

      // line art draws itself in when it enters view
      if (!reduce) {
        const arts = document.querySelectorAll('.art');
        arts.forEach((a) => a.classList.add('pre'));
        const aio = new IntersectionObserver(
          (es) =>
            es.forEach((e) => {
              if (!e.isIntersecting) return;
              aio.unobserve(e.target);
              e.target.classList.add('drawn');
            }),
          { threshold: 0.35 },
        );
        arts.forEach((a) => aio.observe(a));
      }

      // carousel arrows
      const car = document.querySelector<HTMLElement>('[data-car]');
      const w = () => car?.querySelector<HTMLElement>('.car__item')?.offsetWidth ?? 300;
      document.querySelector('[data-prev]')?.addEventListener('click', () => car?.scrollBy({ left: -w(), behavior: 'smooth' }));
      document.querySelector('[data-next]')?.addEventListener('click', () => car?.scrollBy({ left: w(), behavior: 'smooth' }));

      // import log
      const term = document.querySelector<HTMLElement>('[data-term]');
      if (term && !reduce) {
        const lines = [...term.querySelectorAll<HTMLElement>('.term p')];
        lines.forEach((l) => l.classList.add('hide'));
        const t = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          t.disconnect();
          lines.forEach((l, i) => setTimeout(() => l.classList.remove('hide'), 250 + i * 420));
        });
        t.observe(term);
      }

      // savings calculator (same model as batchrx.com: scripts × 3.5% × $175)
      const calc = document.querySelector<HTMLElement>('[data-calc]');
      if (calc) {
        const input = calc.querySelector<HTMLInputElement>('input')!;
        const o = (k: string) => calc.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
        const upd = () => {
          const rx = Number(input.value);
          const d = rx * 0.035;
          const s = Math.round(d * 175);
          o('rx').textContent = rx >= 10000 ? '10,000+' : rx.toLocaleString('en-US');
          o('d').textContent = d.toFixed(1);
          o('s').textContent = '$' + s.toLocaleString('en-US');
          o('x').textContent = Math.max(1, Math.round(s / 350)) + '×';
          input.style.setProperty('--p', ((rx - 100) / 9900) * 100 + '%');
        };
        input.addEventListener('input', upd);
        upd();
      }
    </script>
  </body>
</html>
