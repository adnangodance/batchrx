      <!-- ================= FINAL ================= -->
      <section class="wrap" id="demo">
        <div class="panel panel--a final rv">
          <div class="ui" style="max-width:640px;padding:44px 40px;text-align:center">
            <svg viewBox="0 0 27.7279 27.7279" width="34" height="34" style="margin:0 auto 22px;display:block" aria-hidden="true"><path d={LOGO} fill="#3fd68a"></path></svg>
            <h2 class="t1" style="font-size:clamp(30px,3vw,40px);margin:0 auto">Ready to know more?<br /><span>Get in touch with our team.</span></h2>
            <div class="ctas" style="justify-content:center;margin-top:30px">
              <a href="/#demo" class="pill pill--lg pill--glow">Request a demo <Icon name="chevron" size={16} stroke={2} /></a>
