---
import Layout from '../v4/Layout.astro';
import Header from '../v4/Header.astro';
import Hero from '../v4/Hero.astro';
import Problems from '../v4/Problems.astro';
import Approach from '../v4/Approach.astro';
import Steps from '../v4/Steps.astro';
import Plan from '../v4/Plan.astro';
import Stories from '../v4/Stories.astro';
import Process from '../v4/Process.astro';
import Cost from '../v4/Cost.astro';
import Closing from '../v4/Closing.astro';

const LT = '#f3f3f1';
const DK = '#0d2b27';
const WH = '#ffffff';
---

<Layout>
  <Header />
  <main id="main">
    <Hero />
    <Problems />
    <Approach />
    <Steps from={LT} to={DK} />
    <Plan />
    <Steps from={DK} to={LT} flip />
    <Stories />
    <Steps from={LT} to={WH} />
    <Process />
    <Cost />
    <Steps from={WH} to={LT} flip />
    <Closing />
  </main>
</Layout>
