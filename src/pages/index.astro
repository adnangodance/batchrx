---
import '../v3-hoplite/hoplite.css';
import Layout from '../v4/Layout.astro';
import Header from '../v4/Nav.astro';
import Hero from '../v3-hoplite/Hero.astro';
import Problems from '../v4/Problems.astro';
import Approach from '../v4/Approach.astro';
import Gap from '../v4/Gap.astro';
import Plan from '../v4/Plan.astro';
import Stories from '../v4/Stories.astro';
import Process from '../v4/Process.astro';
import Cost from '../v4/Cost.astro';
import Start from '../v4/Start.astro';
import Closing from '../v4/Closing.astro';

---

<Layout>
  <Header />
  <main id="main">
    <div class="hk-scope">
      <Hero badge={false} />
    </div>
    <Gap />
    <Problems />
    <Gap />
    <Approach />
    <Gap />
    <Plan />
    <Gap />
    <Stories />
    <Gap />
    <Process />
    <Gap />
    <Cost />
    <Gap />
    <Start />
    <Gap />
    <Closing />
  </main>
</Layout>

<!-- Version 1 typography, matched to Version 6: Inter with default glyphs, regular-weight
     headings on a slightly looser track, and uppercase Geist Mono labels. Global to this page only. -->
<style is:global>
  html:root {
    --sans: 'Inter Variable', Inter, 'Helvetica Neue', Arial, sans-serif;
    --mono: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    /* Version 6 palette mapped onto Version 1's tokens: black ink, white panels,
       sage tiles and rules, one bright green. */
    --sage: #eff5ec;
    --sage-2: #dfe9d9;
    --sage-3: #c9d8c2;
    --gut: 12px;
    --dk: #000;
    --dk-2: #0b0b0b;
    --dk-3: #1a1a1a;
    --dk-line: rgba(255, 255, 255, 0.16);
    --dk-line-2: rgba(255, 255, 255, 0.28);
    --dk-txt: rgba(255, 255, 255, 0.72);
    --lt: #fff;
    --lt-2: var(--sage);
    --card: var(--sage);
    --line: var(--sage-2);
    --line-2: var(--sage-3);
    --ink: #000;
    --ink-2: #3d443b;
    --ink-3: #6c7868;
    --ink-4: #8d9c88;
    --brand: #003d1a;
    --glow: #14e56f;
    --glow-2: #b6f5c3;
    --ok: #0a8f45;
    --ok-bg: #d9f8d2;
  }

  /* ---------- Page: white panels on a dotted field ---------- */
  body {
    background: #fff radial-gradient(var(--sage-3) 0.9px, transparent 1.1px) 0 0 / 5px 5px;
  }
  main > section,
  main > .hk-scope {
    margin-inline: var(--gut);
    background-color: #fff;
  }
  main > .hk-scope {
    overflow: hidden;
  }
  body .on-dk {
    background-color: #000;
    color: #fff;
  }

  /* Section labels become Version 6 chips */
  body .kick {
    display: inline-block;
    justify-self: start;
    width: fit-content;
    min-width: 138px;
    padding: 4px 8px;
    background: #000;
    color: #fff;
    font: 400 12px/1.3 var(--mono);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  body .kick::before {
    content: ':: ';
    opacity: 0.7;
  }
  body .on-dk .kick {
    background: var(--sage);
    color: #000;
  }
  body .hk-scope,
  body .hk-header {
    --hk-font-system: var(--sans);
    --hk-font-mono: var(--mono);
    /* Black ink, as everywhere else on the page */
    --hk-cream: #000;
    --hk-ink: #000;
    --hk-night: #000;
    --hk-ink-soft: #3d443b;
    /* Line the hero and header up with the v4 sections below */
    --hk-page: var(--wrap);
    --hk-gutter: var(--pad);
  }
  body {
    font-feature-settings: normal;
  }
  h1,
  h2,
  h3 {
    font-weight: 400;
  }
  body .d1,
  body .d2 {
    letter-spacing: -0.028em;
    line-height: 1.04;
  }
  body .d3 {
    letter-spacing: -0.02em;
  }

  /* ---------- Hero copy, in the Version 6 manner: jumbo headline over a small, narrow lede ---------- */
  body .hk-hp {
    padding-top: clamp(32px, 4vw, 56px);
  }
  body .hk-hp__title {
    max-width: 15ch;
    font-size: clamp(46px, 7.25vw, 106px);
    line-height: 1;
    letter-spacing: -0.032em;
  }
  body .hk-hp__body {
    max-width: 38ch;
    margin-top: clamp(20px, 3vw, 44px);
    font-size: 15.5px;
    line-height: 1.45;
    color: var(--ink);
  }
  body .hk-hp__actions {
    margin-top: 20px;
    gap: 10px;
  }

  /* ---------- Buttons, in the Version 6 manner: flat, square, label left and caret right ---------- */
  body .btn,
  body .hk-hp__actions .hk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-width: 180px;
    height: auto;
    padding: 10px 14px;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    border: 1px solid #fff;
    border-radius: 0;
    background: #fff;
    color: var(--dk);
    box-shadow: none;
    transition:
      background 0.18s,
      color 0.18s,
      border-color 0.18s;
  }
  body .btn--dark,
  body .hk-hp__actions .hk-btn--primary {
    border-color: var(--dk);
    background: var(--dk);
    color: #fff;
  }
  body .hk-hp__actions .hk-btn--line {
    border-color: var(--line-2);
  }
  body .btn::after,
  body .hk-hp__actions .hk-btn::after {
    content: '';
    border: 4px solid transparent;
    border-left: 6px solid currentColor;
    border-right: 0;
    transition: transform 0.18s;
  }
  body .btn:hover,
  body .hk-hp__actions .hk-btn--primary:hover {
    border-color: var(--glow);
    background: var(--glow);
    color: var(--dk);
  }
  body .hk-hp__actions .hk-btn--line:hover {
    border-color: var(--line-2);
    background: var(--lt-2);
  }
  body .btn:hover::after,
  body .hk-hp__actions .hk-btn:hover::after {
    transform: translateX(3px);
  }
  /* The old framed label + arrow box collapse into the single flat button */
  body .btn .btn__l,
  body .btn:hover .btn__l {
    padding: 0;
    background: none;
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
  }
  body .btn .btn__a,
  body .hk-hp__actions .hk-btn svg {
    display: none;
  }
  body .btn--sm {
    min-width: 0;
    gap: 0;
    padding: 8px 14px;
    font-size: 14px;
  }
  body .btn--sm::after {
    display: none;
  }
</style>
