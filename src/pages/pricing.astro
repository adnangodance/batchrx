---
/**
 * Pricing page, in the Version 1 style: white panels on a dotted field,
 * square tiles, mono labels, black ink and one bright green.
 */
import Layout from '../v4/Layout.astro';
import '../v4/theme.css';
import Header from '../v4/Nav.astro';
import Gap from '../v4/Gap.astro';
import Footer from '../v4/Footer.astro';
import { site, plans } from '../site';

const demo = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/#demo`;

---

<Layout
  title="Pricing | BatchRx"
  description={`BatchRx pricing: ${plans.map((p) => `${p.name} $${p.price}/month`).join(', ')}. The Desktop App stores zero data on the cloud. Billed monthly, no setup fees, cancel anytime.`}
>
  <Header />
  <main id="main">
    <section class="ph" aria-labelledby="ph-h">
      <div class="wrap">
        <div class="ph__grid">
          <div class="ph__copy">
            <span class="kick rv">Pricing</span>
            <h1 id="ph-h" class="rv" style="--d:.05s">Three plans. No per-audit charges.</h1>
          </div>
          <div class="ph__side">
            <p class="ph__lede rv" style="--d:.1s">
              Pick the software alone, add a specialist for every audit, or run BatchRx as a desktop application that
              stores zero data on the cloud.
            </p>
            <div class="ph__cta rv" style="--d:.14s">
              <a href={site.registerUrl} class="btn btn--dark"><span class="btn__l">Get started</span></a>
              <a href={demo} class="btn ph__ghost"><span class="btn__l">Book a demo</span></a>
            </div>
          </div>
        </div>

        <div class="tiles">
          {
            plans.map((p, i) => (
              <article class:list={['tile rv', { 'on-dk': p.featured }]} style={`--d:${i * 0.06}s`}>
                <div class="tile__top">
                  <span class="kick">{p.name}</span>
                  <span class="mono">{String(i + 1).padStart(3, '0')}</span>
                </div>
                <p class="tile__line">{p.line}</p>
                <div class="tile__price">
                  <b class="tnum">${p.price}</b>
                  <span class="mono">
                    / month
                    <br />
                    per pharmacy
                  </span>
                </div>
                <ul class="tile__list">
                  {p.points.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
                <a
                  href={p.id === 'desktop' ? demo : site.registerUrl}
                  class:list={['btn tile__btn', { 'btn--dark': !p.featured }]}
                >
                  <span class="btn__l">{p.id === 'desktop' ? 'Talk to a specialist' : 'Start now'}</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <Gap />

    <section class="zc" id="desktop" aria-labelledby="zc-h">
      <div class="wrap">
        <div class="zc__grid">
          <div class="zc__copy">
            <span class="kick rv">Desktop App</span>
            <h2 id="zc-h" class="rv" style="--d:.05s">Zero data on the cloud</h2>
            <p class="zc__lede rv" style="--d:.1s">
              The BatchRx desktop application runs on your pharmacy’s own computer. Your purchase and claims data
              stays there, and none of it is stored on the cloud.
            </p>
            <a href={demo} class="btn btn--dark rv" style="--d:.14s"
              ><span class="btn__l">Ask about the Desktop App</span></a
            >
          </div>

          <div class="zc__panel rv" style="--d:.1s">
            <div class="zc__bar">
              <span class="mono">Records stored on the cloud</span>
              <span class="mono zc__live"><i></i>Local only</span>
            </div>
            <div class="zc__zero" aria-hidden="true">
              <b class="tnum">0</b>
              <svg viewBox="0 0 96 72" width="96" height="72" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M26 56h44a16 16 0 0 0 2-31.9A22 22 0 0 0 29.6 28 14 14 0 0 0 26 56Z"></path>
                <path d="M12 66 84 8"></path>
              </svg>
            </div>
            <ul class="zc__log">
              {
                ['Purchases', 'Claims', 'Documents'].map((x) => (
                  <li>
                    <span class="mono">{x}</span>
                    <span class="mono zc__here">On your computer</span>
                  </li>
                ))
              }
              <li>
                <span class="mono">Cloud</span>
                <span class="mono">Nothing stored</span>
              </li>
            </ul>
          </div>
        </div>
        <ul class="zc__row">
          <li><span class="mono">001</span><b>Installed on your computer</b></li>
          <li><span class="mono">002</span><b>No data stored on the cloud</b></li>
          <li><span class="mono">003</span><b>${plans[2].price} per month</b></li>
        </ul>
      </div>
      <div class="zc__hatch" aria-hidden="true"></div>
    </section>

    <Gap />

    <Footer />
  </main>
</Layout>

<style>
  .mono {
    font: 400 12px/1.35 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ---------- Hero ---------- */
  .ph {
    padding-top: clamp(32px, 4vw, 56px);
  }
  .ph__grid {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 400px);
    gap: clamp(24px, 5vw, 80px);
    align-items: end;
    padding-bottom: clamp(32px, 4vw, 56px);
  }
  .ph__copy {
    display: grid;
    justify-items: start;
  }
  .ph h1 {
    max-width: 13ch;
    margin-top: 22px;
    font-size: clamp(46px, 7.25vw, 106px);
    line-height: 1;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }
  .ph__lede {
    font-size: 15.5px;
    line-height: 1.45;
  }
  .ph__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .ph__ghost {
    border-color: var(--line-2);
  }
  .ph__ghost:hover {
    border-color: var(--line-2);
    background: var(--lt-2);
  }

  /* ---------- Plan tiles ---------- */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gut);
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .tile {
    display: flex;
    flex-direction: column;
    min-height: clamp(420px, 36vw, 500px);
    padding: 20px;
    background: var(--sage);
    --rule: var(--sage-3);
  }
  .tile.on-dk {
    background: #000;
    --rule: var(--dk-line);
  }
  .tile__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .tile.on-dk .mono {
    color: var(--dk-txt);
  }
  .tile__line {
    max-width: 30ch;
    margin-top: 18px;
    font-size: 15.5px;
    line-height: 1.4;
  }
  .tile__price {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    margin-top: auto;
    padding-top: 40px;
  }
  .tile__price b {
    font-size: clamp(72px, 7.4vw, 112px);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.05em;
  }
  .tile__list {
    display: grid;
    margin-top: 24px;
    border-top: 1px solid var(--rule);
    font-size: 14.5px;
  }
  .tile__list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--rule);
  }
  .tile__list li::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--glow);
  }
  .tile:not(.on-dk) .tile__list li::before {
    background: #000;
  }
  .tile__btn {
    width: 100%;
    margin-top: 20px;
  }

  /* ---------- Zero data on the cloud: a green slab with a black readout ---------- */
  .zc {
    padding-top: clamp(48px, 6vw, 88px);
    background: var(--glow);
    color: #000;
  }
  .zc .mono {
    color: rgba(0, 0, 0, 0.62);
  }
  .zc__grid {
    display: grid;
    grid-template-columns: 1fr minmax(300px, 500px);
    gap: clamp(32px, 5vw, 80px);
    align-items: stretch;
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .zc__copy {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 22px;
  }
  .zc h2 {
    max-width: 10ch;
    font-size: clamp(46px, 7.25vw, 106px);
    line-height: 1;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }
  .zc__lede {
    max-width: 44ch;
    font-size: 15.5px;
    line-height: 1.45;
  }
  .zc .btn:hover {
    border-color: #fff;
    background: #fff;
    color: #000;
  }

  .zc__panel {
    display: flex;
    flex-direction: column;
    background: #000;
    color: #fff;
  }
  .zc .zc__panel .mono {
    color: rgba(255, 255, 255, 0.62);
  }
  .zc__bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--dk-line);
  }
  .zc .zc__panel .zc__live,
  .zc .zc__panel .zc__here {
    color: var(--glow);
  }
  .zc__live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .zc__live i {
    width: 7px;
    height: 7px;
    background: var(--glow);
    animation: zc-blink 1.6s steps(2, jump-none) infinite;
  }
  @keyframes zc-blink {
    to {
      opacity: 0.15;
    }
  }
  .zc__zero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex: 1;
    min-height: 240px;
    padding: 28px 20px 20px;
    /* a faint grid behind the numeral */
    background:
      linear-gradient(var(--dk-line) 1px, transparent 1px) 0 -1px / 40px 40px,
      linear-gradient(90deg, var(--dk-line) 1px, transparent 1px) -1px 0 / 40px 40px;
  }
  .zc__zero b {
    font-size: clamp(170px, 19vw, 280px);
    font-weight: 400;
    line-height: 0.76;
    letter-spacing: -0.05em;
    color: var(--glow);
  }
  .zc__zero svg {
    color: rgba(255, 255, 255, 0.72);
  }
  .zc__log {
    border-top: 1px solid var(--dk-line);
  }
  .zc__log li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 20px;
  }
  .zc__log li + li {
    border-top: 1px solid var(--dk-line);
  }

  .zc__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .zc__row li {
    display: flex;
    flex-direction: column;
    min-height: clamp(110px, 11vw, 150px);
    padding: 0 0 14px 24px;
    border-left: 1px solid rgba(0, 0, 0, 0.28);
  }
  .zc__row b {
    margin-top: auto;
    font-size: clamp(19px, 1.9vw, 26px);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .zc__hatch {
    height: 22px;
    border-top: 1px solid rgba(0, 0, 0, 0.28);
    background: repeating-linear-gradient(-45deg, transparent 0 6px, rgba(0, 0, 0, 0.28) 6px 7px);
  }
  @media (prefers-reduced-motion: reduce) {
    .zc__live i {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .ph__grid,
    .zc__grid,
    .tiles {
      grid-template-columns: 1fr;
    }
    .tile {
      min-height: 0;
    }
    .zc__row li {
      min-height: 96px;
      padding-left: 14px;
    }
  }
  @media (max-width: 560px) {
    .zc__row {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }
    .zc__row li {
      min-height: 72px;
    }
  }
</style>
