<!doctype html>
<html lang="en" style={rootVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BatchRx — Keep every claim you’ve earned</title>
    <meta
      name="description"
