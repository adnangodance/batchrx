                    <div class="app__row"><span>CVS Caremark<small>Invoice · October</small></span><span class="tag">Sent ✓</span></div>
                    <div class="app__row"><span>OptumRx<small>OnSite · Nov 14</small></span><span class="tag">Prepped</span></div>
                  </div>
