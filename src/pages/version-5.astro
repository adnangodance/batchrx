            <article class="scale__card scale__card--b rv" style="--d:.07s">
              <svg class="usmap" viewBox="0 0 47 25.6" role="img" aria-label="Dot map of the United States">
                {mapDots.map((d) => <circle cx={d.x} cy={d.y} r={d.hot ? 0.36 : 0.3} class={d.hot ? 'hot' : undefined}></circle>)}
              </svg>
              <p>
                From single neighborhood pharmacies to twelve-store groups, we turn monthly invoice reconciliation into
                a standing defense.
              </p>
            </article>

            <article class="scale__card scale__card--c rv" style="--d:.14s">
              <p class="scale__k">Recoupments prevented</p>
              <p class="scale__big tnum">$50 million+</p>
              <p class="scale__t">Saved in audit recoupments</p>
              <div class="scale__mini">
                <span><b class="tnum">400+</b>Active pharmacies</span>
                <span><b class="tnum">50</b>States served</span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ================= TOOLS BENTO ================= -->
      <section class="tools" id="platform" aria-labelledby="tools-h">
        <div class="wrap wrap--narrow">
          <h2 id="tools-h" class="h2 rv">The right tool for every audit</h2>

          <div class="bento">
            <article class="card rv">
              <h3>Inventory report</h3>
              <p>Purchased versus billed for every NDC, across primary, secondary and reverse distributors.</p>
              <div class="viz-inv" aria-hidden="true">
                <div><span>Atorvastatin</span><i style="--w:100%"></i><span class="mono">360/360</span></div>
                <div><span>Metformin</span><i style="--w:100%"></i><span class="mono">540/540</span></div>
                <div class="short"><span>Lisinopril</span><i style="--w:80%"></i><span class="mono">120/150</span></div>
              </div>
              <a href="#demo" class="round" aria-label="See the inventory report in a demo">
                <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"></path></svg>
              </a>
            </article>

