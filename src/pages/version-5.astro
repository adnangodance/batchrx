const tex = (name: string) => `url('${base}/v2/${name}.jpg')`;
const rootVars = `--tex-hero:${tex('brand-d')};--tex-dark:${tex('tex-a')}`;

/* ---------- Dot map of the contiguous US (built at compile time) ---------- */
const US: [number, number][] = [
  [-124.6, 48.3], [-122.8, 49.0], [-95.2, 49.0], [-90.0, 47.8], [-87.5, 46.6], [-84.5, 46.4], [-82.5, 45.3],
  [-82.4, 43.0], [-83.1, 42.0], [-79.0, 42.8], [-79.0, 43.3], [-76.3, 43.6], [-75.0, 45.0], [-71.5, 45.0],
  [-70.3, 46.5], [-69.2, 47.4], [-68.0, 47.3], [-67.0, 44.8], [-70.0, 43.7], [-70.7, 42.0], [-70.0, 41.7],
  [-71.5, 41.3], [-74.0, 40.6], [-74.2, 39.5], [-75.5, 38.0], [-76.0, 36.9], [-75.6, 35.3], [-77.5, 34.2],
  [-79.5, 33.0], [-81.2, 31.5], [-81.4, 30.3], [-80.2, 27.2], [-80.2, 25.3], [-81.2, 25.2], [-82.8, 27.8],
  [-82.7, 29.2], [-84.2, 30.0], [-85.5, 29.8], [-88.0, 30.3], [-89.6, 30.2], [-89.4, 29.2], [-91.5, 29.4],
  [-93.8, 29.7], [-95.2, 29.0], [-97.2, 27.6], [-97.3, 26.0], [-99.2, 26.6], [-100.5, 28.5], [-101.5, 29.8],
  [-102.8, 29.3], [-104.5, 29.8], [-106.5, 31.8], [-108.2, 31.4], [-111.0, 31.3], [-114.8, 32.5], [-117.1, 32.5],
  [-118.4, 33.8], [-120.6, 34.5], [-121.9, 36.6], [-122.5, 37.8], [-123.8, 39.8], [-124.3, 40.4], [-124.2, 42.0],
  [-124.5, 42.9], [-124.0, 46.2],
];
const inUS = (x: number, y: number) => {
  let hit = false;
  for (let i = 0, j = US.length - 1; i < US.length; j = i++) {
    const [xi, yi] = US[i];
    const [xj, yj] = US[j];
    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) hit = !hit;
  }
  return hit;
};
const cities: [number, number][] = [
  [-74.0, 40.7], [-87.6, 41.9], [-95.4, 29.9], [-118.2, 34.1], [-80.3, 26.0], [-122.3, 47.5], [-104.9, 39.7], [-84.4, 33.7],
];
const mapDots: { x: number; y: number; hot: boolean }[] = [];
for (let row = 0, lat = 49.3; lat > 24.8; lat -= 0.86, row++) {
  for (let lon = -125 + (row % 2 ? 0.64 : 0); lon < -66.4; lon += 1.28) {
    if (!inUS(lon, lat)) continue;
    const hot = cities.some(([cx, cy]) => Math.hypot((cx - lon) * 0.79, cy - lat) < 0.62);
    mapDots.push({ x: +((lon + 125.4) * 0.79).toFixed(2), y: +(49.9 - lat).toFixed(2), hot });
  }
}

