    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Mobile menu
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
      const mnav = nav.querySelector<HTMLElement>('[data-mnav]')!;
      const setMenu = (open: boolean) => {
        mnav.hidden = !open;
        nav.classList.toggle('is-menu', open);
        burger.setAttribute('aria-expanded', String(open));
      };
      burger.addEventListener('click', () => setMenu(mnav.hasAttribute('hidden')));
      mnav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      // Dropdowns: hover on pointer devices, click/keyboard everywhere
      const drops = [...document.querySelectorAll<HTMLElement>('[data-drop]')];
      const setDrop = (el: HTMLElement | null) =>
        drops.forEach((d) => {
          const on = d === el;
          d.classList.toggle('is-open', on);
          d.querySelector('button')!.setAttribute('aria-expanded', String(on));
        });
      drops.forEach((d) => {
        d.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && setDrop(d));
        d.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && setDrop(null));
        d.querySelector('button')!.addEventListener('click', () => setDrop(d.classList.contains('is-open') ? null : d));
        d.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setDrop(null)));
        d.addEventListener('focusout', (e) => {
          if (!d.contains(e.relatedTarget as Node)) setDrop(null);
        });
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && setDrop(null));

      // Independent / Multi-store switch
      const copy = {
        single: {
          title: 'Keep every claim you’ve earned',
          sub: 'Catch invoice shortages early, stop recoupments and answer every PBM audit with confidence—with continuous NDC reconciliation and a dedicated audit specialist.',
        },
        multi: {
          title: 'Every location, defended from one screen',
          sub: 'Oversee reconciliation rates, wholesaler shortages and active audit deadlines across your whole group—with a dedicated specialist behind every store.',
        },
      };
      const title = document.querySelector<HTMLElement>('[data-mode-title]')!;
      const sub = document.querySelector<HTMLElement>('[data-mode-sub]')!;
      const modeBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-mode]')];
      modeBtns.forEach((b) =>
        b.addEventListener('click', () => {
          const c = copy[b.dataset.mode as keyof typeof copy];
          modeBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          title.textContent = c.title;
          sub.textContent = c.sub;
        }),
      );

      // Reveal on scroll
      const rv = document.querySelectorAll('.rv');
      if (reduce) rv.forEach((el) => el.classList.add('in'));
      else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((en) => {
              if (en.isIntersecting) {
                en.target.classList.add('in');
                io.unobserve(en.target);
              }
            }),
          { rootMargin: '0px 0px -6% 0px' },
        );
        rv.forEach((el) => io.observe(el));
      }

      // Scroll-lit headlines: words go from grey to black as they travel up the viewport
      const faders = [...document.querySelectorAll<HTMLElement>('[data-fade-words]')].map((el) => {
        const words = el.textContent!.trim().split(/\s+/);
        el.setAttribute('aria-label', words.join(' '));
        el.innerHTML = words.map((w) => `<span class="w" aria-hidden="true">${w}</span>`).join(' ');
        return { el, spans: [...el.querySelectorAll<HTMLElement>('.w')] };
      });
      const light = () => {
        const vh = window.innerHeight;
        faders.forEach(({ el, spans }) => {
          const r = el.getBoundingClientRect();
          const p = (vh * 0.92 - r.top) / (vh * 0.5 + r.height * 0.6);
          const n = Math.round(Math.min(1, Math.max(0, p)) * spans.length);
          spans.forEach((s, i) => s.classList.toggle('on', i < n));
        });
      };
      if (!reduce) {
        let tick = false;
        window.addEventListener(
          'scroll',
          () => {
            if (tick) return;
            tick = true;
            requestAnimationFrame(() => {
              light();
              tick = false;
            });
          },
          { passive: true },
        );
        window.addEventListener('resize', light);
        light();
      }

      // Steps: auto-advance while visible until the visitor picks one
      const stepsEl = document.querySelector<HTMLElement>('[data-steps]');
      if (stepsEl) {
        const btns = [...stepsEl.querySelectorAll<HTMLButtonElement>('[data-step]')];
        const screens = [...stepsEl.querySelectorAll<HTMLElement>('[data-screen]')];
        let cur = 0;
        let timer = 0;
        const show = (n: number) => {
          cur = n;
          btns.forEach((b, i) => b.setAttribute('aria-selected', String(i === n)));
          screens.forEach((s, i) => s.classList.toggle('is-on', i === n));
        };
        const stop = () => window.clearInterval(timer);
        btns.forEach((b, i) =>
          b.addEventListener('click', () => {
            stop();
            show(i);
          }),
        );
        if (!reduce) {
          new IntersectionObserver(
            ([en]) => {
              stop();
              if (en.isIntersecting && !stepsEl.dataset.touched)
                timer = window.setInterval(() => show((cur + 1) % btns.length), 3800);
            },
            { threshold: 0.4 },
          ).observe(stepsEl);
          btns.forEach((b) => b.addEventListener('click', () => (stepsEl.dataset.touched = '1')));
        }
      }

      // Stories carousel
      const casesEl = document.querySelector<HTMLElement>('[data-cases]');
      if (casesEl) {
        const slides = [...casesEl.querySelectorAll<HTMLElement>('[data-case]')];
        let ci = 0;
        const go = (n: number) => {
          ci = (n + slides.length) % slides.length;
          slides.forEach((s, i) => s.classList.toggle('is-on', i === ci));
        };
        casesEl.querySelector('[data-prev]')!.addEventListener('click', () => go(ci - 1));
        casesEl.querySelector('[data-next]')!.addEventListener('click', () => go(ci + 1));
      }

      // Audit rail arrows
      const railSec = document.querySelector<HTMLElement>('[data-rail-sec]');
      if (railSec) {
        const rail = railSec.querySelector<HTMLElement>('[data-rail]')!;
        const prev = railSec.querySelector<HTMLButtonElement>('[data-prev]')!;
        const next = railSec.querySelector<HTMLButtonElement>('[data-next]')!;
        const stepBy = () => (rail.querySelector<HTMLElement>('.tile')!.offsetWidth + 20) * 2;
        const sync = () => {
          prev.disabled = rail.scrollLeft < 4;
          next.disabled = rail.scrollLeft > rail.scrollWidth - rail.clientWidth - 4;
        };
        prev.addEventListener('click', () => rail.scrollBy({ left: -stepBy(), behavior: reduce ? 'auto' : 'smooth' }));
        next.addEventListener('click', () => rail.scrollBy({ left: stepBy(), behavior: reduce ? 'auto' : 'smooth' }));
        rail.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync);
        sync();
      }

      // Savings estimate
      const calc = document.querySelector<HTMLElement>('[data-calc]');
      if (calc) {
        const input = calc.querySelector<HTMLInputElement>('input')!;
        const out = (k: string) => calc.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
        const update = () => {
          const rx = Number(input.value);
          const disc = rx * 0.035;
          const save = Math.round(disc * 175);
          input.style.setProperty('--p', ((rx - 100) / 9900) * 100 + '%');
          out('rx').textContent = rx >= 10000 ? '10,000+' : rx.toLocaleString('en-US');
          out('d').textContent = disc.toFixed(1);
          out('s').textContent = '$' + save.toLocaleString('en-US');
          out('x').textContent = Math.max(1, Math.round(save / 350)) + '×';
        };
        input.addEventListener('input', update);
        update();
      }

      // Demo form
      const form = document.querySelector<HTMLFormElement>('[data-demo-form]');
      if (form) {
        const msg = form.querySelector<HTMLElement>('[data-fmsg]')!;
        const endpoint = form.dataset.endpoint || '';
        form.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          let ok = true;
          form.querySelectorAll<HTMLInputElement>('input[required]').forEach((inp) => {
            const valid = inp.checkValidity() && inp.value.trim().length > 0;
            inp.classList.toggle('is-err', !valid);
            if (!valid) ok = false;
          });
          msg.classList.toggle('is-err', !ok);
          if (!ok) {
            msg.textContent = 'Please complete all fields.';
            return;
          }
          const data = Object.fromEntries(new FormData(form).entries());
          if (!endpoint) {
            form.reset();
            msg.textContent = `Demo request received for ${data.pharmacyName}. Our audit team will reach out shortly.`;
            return;
          }
          msg.textContent = 'Sending request…';
          try {
            const r = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });
            if (!r.ok) throw new Error('bad status');
            form.reset();
            msg.textContent = 'Thank you — a BatchRx specialist will reach out within one business day.';
          } catch {
            msg.classList.add('is-err');
            msg.textContent = 'Could not send right now. Please try again or visit batchrx.com.';
          }
        });
      }
    </script>
  </body>
</html>
