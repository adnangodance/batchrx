          <div class="switch" role="group" aria-label="Pharmacy type" data-mode-switch>
            <button type="button" aria-pressed="true" data-mode="single">Independent</button>
            <button type="button" aria-pressed="false" data-mode="multi">Multi-store</button>
          </div>
        </div>

        <nav class="nav__links" aria-label="Primary">
          <div class="nav__item" data-drop>
            <button type="button" class="nav__link" aria-expanded="false">
              Platform
              <svg viewBox="0 0 10 6" width="10" height="6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m1 1 4 4 4-4"></path></svg>
            </button>
            <div class="mega">
