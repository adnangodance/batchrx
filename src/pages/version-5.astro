          </div>
          <div class="nav__item" data-drop>
            <button type="button" class="nav__link" aria-expanded="false">
              Audits
              <svg viewBox="0 0 10 6" width="10" height="6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m1 1 4 4 4-4"></path></svg>
            </button>
            <div class="mega">
              {megaAudits.map(([t, d]) => <a href="#audits"><b>{t}</b><small>{d}</small></a>)}
