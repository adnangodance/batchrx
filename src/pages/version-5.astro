          <h2 id="scale-h" class="h2 rv">Protecting 400+ pharmacies across all 50 states</h2>
          <div class="scale__row">
            <article class="scale__card scale__card--a rv">
              <p class="scale__k">Proven experience</p>
              <p class="scale__t">13,500+ audits generated</p>
