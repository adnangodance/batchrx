---
import { payers } from '../site';

const pains = [
  {
    n: '01',
    t: 'Invoice audits',
    b: 'PBMs compare the units you billed against the units your wholesalers say you bought. Any gap can be clawed back, even if every prescription was legitimate.',
  },
  {
    n: '02',
    t: 'Desktop & onsite audits',
    b: 'A letter arrives asking for signatures, hard copies and copay records for dozens of prescriptions, on a deadline, on top of running a pharmacy.',
  },
  {
    n: '03',
    t: 'CMS & investigative audits',
    b: 'Higher stakes, more paperwork, and rules that are easy to get wrong without someone who has been through it many times before.',
  },
];
---

<section class="payers" aria-label="Payers">
  <div class="wrap payers__in">
    <p class="mono">Support for audits from</p>
    <div class="payers__track-wrap">
      <ul class="payers__track" aria-label={payers.join(', ')}>
        {[...payers, ...payers].map((p, i) => <li aria-hidden={i >= payers.length ? 'true' : undefined}>{p}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="problem" aria-labelledby="problem-h">
  <div class="wrap">
    <div class="problem__head">
      <span class="kicker kicker--light rv">The problem</span>
      <h2 id="problem-h" class="display h-lg rv" style="--d:.06s">
        Most pharmacies find a shortage the day the <em>recoupment letter</em> arrives.
      </h2>
      <p class="lede rv" style="--d:.12s">
        By then the money is already gone. BatchRx moves that moment forward, so you see what an auditor would see
        months before they do, and you're never alone when the letter comes anyway.
      </p>
    </div>

    <ol class="pains">
      {
        pains.map((p, i) => (
          <li class="pain rv" style={`--d:${i * 0.08}s`}>
            <span class="mono pain__n">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.b}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .payers {
    border-block: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.35);
  }
  .payers__in {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 84px;
  }
  .payers p {
    flex: none;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .payers__track-wrap {
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .payers__track {
    display: flex;
    gap: 48px;
    width: max-content;
    animation: marquee 44s linear infinite;
  }
  .payers__track li {
    font-family: var(--serif);
    font-size: 26px;
    color: #7c8984;
    white-space: nowrap;
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }

  .problem {
    background: var(--g-900);
    color: #fff;
    padding-block: clamp(88px, 11vw, 160px);
    position: relative;
    overflow: hidden;
  }
  .problem::before {
    content: '';
    position: absolute;
    right: -200px;
    top: -200px;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(214, 240, 122, 0.14), transparent);
  }
  .problem__head {
    position: relative;
    display: grid;
    gap: 28px;
    max-width: 980px;
    margin-bottom: clamp(56px, 8vw, 96px);
  }
  .problem h2 em {
    color: var(--lime);
  }
  .problem .lede {
    color: rgba(216, 229, 224, 0.78);
  }
  .pains {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(216, 229, 224, 0.18);
  }
  .pain {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 32px 32px 0 0;
  }
  .pain + .pain {
    padding-left: 32px;
    border-left: 1px solid rgba(216, 229, 224, 0.18);
  }
  .pain__n {
    font-size: 12px;
    color: var(--lime);
  }
  .pain h3 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .pain p {
    font-size: 15px;
    color: rgba(216, 229, 224, 0.72);
  }
  @media (max-width: 860px) {
    .pains {
      grid-template-columns: 1fr;
    }
    .pain,
    .pain + .pain {
      padding: 28px 0;
      border-left: 0;
      border-bottom: 1px solid rgba(216, 229, 224, 0.18);
    }
    .payers p {
      display: none;
    }
  }
</style>
