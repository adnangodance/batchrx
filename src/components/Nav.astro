---
import Logo from './Logo.astro';
import { site } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: '#platform', label: 'Platform' },
  { href: '#audit-support', label: 'Audit support' },
  { href: '#integrations', label: 'Integrations' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a href={`${base}/`} aria-label="BatchRx home" class="nav__logo">
      <span class="logo-dark"><Logo tone="light" /></span>
      <span class="logo-light"><Logo /></span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="nav__actions">
      <a href={site.loginUrl} class="nav__login">Log in</a>
      <a href="#demo" class="btn btn--sm nav__cta">Request demo</a>
      <button class="nav__toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="nav__mobile" id="mobile-menu" hidden>
    <div class="container">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={site.loginUrl}>Log in</a>
      <a href="#demo" class="btn btn--primary">Request demo</a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('[data-toggle]')!;
  const menu = nav.querySelector<HTMLElement>('#mobile-menu')!;
  const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.hidden = !open;
    nav.classList.toggle('is-open', open);
  };
  toggle.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      background-color 0.3s,
      box-shadow 0.3s,
      border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 72px;
  }
  .nav__logo {
    display: grid;
  }
  .nav__logo > span {
    grid-area: 1 / 1;
    transition: opacity 0.3s;
  }
  .logo-light {
    opacity: 0;
  }
  .nav__links {
    display: flex;
    gap: 4px;
    margin-inline: auto;
  }
  .nav__links a {
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--mint-200);
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .nav__links a:hover {
    color: var(--white);
    background: rgba(216, 229, 224, 0.08);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav__login {
    font-size: 14px;
    color: var(--mint-200);
  }
  .nav__login:hover {
    color: var(--white);
  }
  .nav__cta {
    background: var(--white);
    color: var(--green-900);
  }
  .nav__cta:hover {
    background: var(--mint-200);
  }

  .nav.is-scrolled,
  .nav.is-open {
    background: rgba(250, 250, 248, 0.86);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-color: var(--line);
  }
  .nav.is-scrolled .logo-light,
  .nav.is-open .logo-light {
    opacity: 1;
  }
  .nav.is-scrolled .logo-dark,
  .nav.is-open .logo-dark {
    opacity: 0;
  }
  .nav.is-scrolled .nav__links a,
  .nav.is-scrolled .nav__login {
    color: var(--ink-2);
  }
  .nav.is-scrolled .nav__links a:hover {
    color: var(--ink);
    background: var(--mint-100);
  }
  .nav.is-scrolled .nav__cta,
  .nav.is-open .nav__cta {
    background: var(--green-800);
    color: var(--white);
  }
  .nav.is-scrolled .nav__cta:hover {
    background: var(--green-900);
  }

  .nav__toggle {
    display: none;
    width: 40px;
    height: 40px;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
  }
  .nav__toggle span {
    position: absolute;
    left: 10px;
    right: 10px;
    height: 2px;
    border-radius: 2px;
    background: var(--mint-200);
    transition:
      transform 0.25s,
      background-color 0.3s;
  }
  .nav__toggle span:first-child {
    top: 15px;
  }
  .nav__toggle span:last-child {
    top: 23px;
  }
  .nav.is-scrolled .nav__toggle span,
  .nav.is-open .nav__toggle span {
    background: var(--ink);
  }
  .nav.is-open .nav__toggle span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .nav.is-open .nav__toggle span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .nav__mobile .container {
    display: grid;
    gap: 4px;
    padding-block: 8px 24px;
  }
  .nav__mobile a:not(.btn) {
    padding: 12px 4px;
    font-size: 17px;
    border-bottom: 1px solid var(--line);
  }
  .nav__mobile .btn {
    margin-top: 16px;
  }

  @media (max-width: 960px) {
    .nav__links,
    .nav__login {
      display: none;
    }
    .nav__actions {
      margin-left: auto;
      gap: 8px;
    }
    .nav__toggle {
      display: block;
    }
  }
  @media (max-width: 420px) {
    .nav__cta {
      display: none;
    }
  }
</style>
