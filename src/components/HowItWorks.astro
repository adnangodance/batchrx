---
const steps = [
  {
    n: '01',
    title: 'Connect your data',
    body: 'Upload files from your pharmacy management system and your primary and secondary wholesalers. BatchRx works with the systems you already use.',
    tag: 'PMS + wholesaler files',
  },
  {
    n: '02',
    title: 'See every discrepancy',
    body: 'BatchRx reconciles purchases against claims, NDC by NDC and payer by payer, and flags shortages and risky claims before they turn into recoupments.',
    tag: 'Flagged before the PBM sees it',
  },
  {
    n: '03',
    title: 'Get one-on-one audit help',
    body: 'When an audit letter arrives, a dedicated specialist walks you through it, from document collection to submission, so nothing is left to chance.',
    tag: 'A real person, every audit',
  },
];
---

<section class="section how" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">How it works</span>
      <h2 id="how-title" class="h2">Software that finds the problems. <span class="serif">People</span> who help you fix them.</h2>
      <p class="lead">
        Audit tools tell you what's wrong. Audit services help after the fact. BatchRx does both, so you're prepared
        before the letter arrives and supported after it does.
      </p>
    </div>

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step card reveal" style={`transition-delay:${i * 0.1}s`}>
            <div class="step__top">
              <span class="step__n mono">{s.n}</span>
              <span class="step__line" aria-hidden="true" />
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <span class="pill pill--green">{s.tag}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how .section-head {
    max-width: 820px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .step {
    padding: 28px;
    display: grid;
    gap: 14px;
    align-content: start;
    justify-items: start;
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.25s,
      border-color 0.25s;
  }
  .step:hover {
    border-color: var(--green-300);
    box-shadow: var(--shadow);
  }
  .step__top {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin-bottom: 8px;
  }
  .step__n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--green-800);
    color: var(--white);
    font-size: 13px;
  }
  .step__line {
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--green-300) 0 4px, transparent 4px 9px);
  }
  .step:last-child .step__line {
    display: none;
  }
  h3 {
    font-size: 20px;
  }
  p {
    color: var(--ink-2);
    font-size: 15px;
  }
  .pill {
    margin-top: 6px;
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .step__line {
      display: none;
    }
  }
</style>
