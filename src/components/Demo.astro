---
import { site } from '../site';
---

<section class="demo" id="demo" aria-labelledby="demo-title">
  <div class="container grid">
    <div class="copy reveal">
      <span class="eyebrow eyebrow--dark">Book a demo</span>
      <h2 id="demo-title" class="h2">Ready to know <span class="serif">more?</span></h2>
      <p class="lead">
        See your own data in BatchRx. We'll show you where your discrepancies are and how we'd support you through your
        next audit.
      </p>
      <ul class="perks">
        <li><span><b>Live walkthrough</b> with our team</span></li>
        <li><span><b>$350/mo</b> · no setup fees · cancel anytime</span></li>
        <li><span><b>HIPAA</b> compliant from day one</span></li>
      </ul>
    </div>

    <form class="form reveal" data-demo-form data-endpoint={site.demoEndpoint ?? ''} novalidate>
      <h3>Request a demo</h3>
      <div class="fields">
        <label>
          <span>Pharmacy name</span>
          <input name="pharmacyName" required autocomplete="organization" />
        </label>
        <label>
          <span>Contact name</span>
          <input name="contactName" required autocomplete="name" />
        </label>
        <label>
          <span>Email</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label>
          <span>Phone</span>
          <input name="phone" type="tel" required autocomplete="tel" />
        </label>
        <label class="full">
          <span>Pharmacy address</span>
          <input name="pharmacyAddress" required autocomplete="street-address" />
        </label>
      </div>
      <button type="submit" class="btn btn--primary">Request demo <span class="arrow" aria-hidden="true">→</span></button>
      <p class="form__status" role="status" aria-live="polite"></p>
      <p class="form__fine">We'll only use your details to contact you about BatchRx.</p>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-demo-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.classList.add('was-validated');
      if (!form.checkValidity()) {
        status.textContent = 'Please fill in all fields.';
        status.dataset.tone = 'error';
        form.querySelector<HTMLInputElement>(':invalid')?.focus();
        return;
      }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        status.textContent = 'The demo form isn’t connected yet. Set PUBLIC_DEMO_ENDPOINT to enable it.';
        status.dataset.tone = 'error';
        return;
      }
      button.disabled = true;
      status.textContent = 'Sending…';
      status.dataset.tone = '';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        form.classList.remove('was-validated');
        status.textContent = 'Thanks! Our team will reach out shortly.';
        status.dataset.tone = 'ok';
      } catch {
        status.textContent = 'Something went wrong. Please try again.';
        status.dataset.tone = 'error';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .demo {
    background: var(--green-900);
    color: var(--white);
    padding-block: clamp(72px, 10vw, 128px);
    position: relative;
    overflow: hidden;
  }
  .demo::before {
    content: '';
    position: absolute;
    left: -10%;
    bottom: -40%;
    width: 900px;
    height: 900px;
    background: radial-gradient(closest-side, rgba(82, 160, 130, 0.25), transparent);
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .h2 {
    font-size: clamp(40px, 6vw, 68px);
  }
  .serif {
    color: var(--mint-200);
  }
  .lead {
    color: rgba(216, 229, 224, 0.8);
  }
  .perks {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: grid;
    gap: 10px;
    color: rgba(216, 229, 224, 0.85);
    font-size: 15px;
  }
  .perks li {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .perks li::before {
    content: '✓';
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: rgba(216, 229, 224, 0.12);
    font-size: 11px;
    color: var(--mint-200);
  }
  .perks b {
    color: var(--white);
    font-weight: 500;
  }

  .form {
    background: var(--white);
    color: var(--ink);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 36px);
    box-shadow: var(--shadow-lg);
    display: grid;
    gap: 20px;
    transition-delay: 0.1s;
  }
  .form h3 {
    font-size: 20px;
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .full {
    grid-column: 1 / -1;
  }
  label {
    display: grid;
    gap: 6px;
  }
  label span {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }
  input {
    height: 46px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--paper);
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      background-color 0.2s;
  }
  input:focus {
    outline: none;
    border-color: var(--green-700);
    background: var(--white);
    box-shadow: 0 0 0 4px var(--mint-100);
  }
  .was-validated input:invalid {
    border-color: var(--red-ink);
  }
  .form .btn {
    width: 100%;
  }
  .form .btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .form__status {
    font-size: 14px;
    min-height: 1px;
  }
  .form__status:empty {
    display: none;
  }
  .form__status[data-tone='ok'] {
    color: var(--green-800);
  }
  .form__status[data-tone='error'] {
    color: var(--red-ink);
  }
  .form__fine {
    font-size: 12px;
    color: var(--ink-3);
    margin-top: -8px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>
