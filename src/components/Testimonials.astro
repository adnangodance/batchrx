---
import { testimonials } from '../site';
const [featured, ...rest] = testimonials;
---

<section class="section testimonials" aria-labelledby="t-title">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">Testimonials</span>
      <h2 id="t-title" class="h2">Here's what our pharmacies are <span class="serif">saying</span></h2>
    </div>

    <div class="wall">
      <figure class="feat reveal">
        <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
        <blockquote>“{featured.quote}”</blockquote>
        <figcaption>
          <span class="avatar">{featured.name[0]}</span>
          <span><b>{featured.name}</b><small>{featured.place}</small></span>
        </figcaption>
        <div class="feat__note">
          <span class="mono">Multi-store</span>
          Running several locations? See every store's discrepancies and audits from one screen.
        </div>
      </figure>

      {
        rest.map((t, i) => (
          <figure class="quote card reveal" style={`transition-delay:${(i + 1) * 0.08}s`}>
            <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote>“{t.quote}”</blockquote>
            <figcaption>
              <span class="avatar">{t.name[0]}</span>
              <span>
                <b>{t.name}</b>
                <small>{t.place}</small>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--white);
    border-block: 1px solid var(--line);
  }
  .wall {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 20px;
  }
  figure {
    margin: 0;
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .feat {
    grid-row: span 2;
    padding: clamp(28px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--green-900);
    color: var(--white);
    align-content: space-between;
  }
  .feat blockquote {
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-weight: 500;
  }
  .feat .avatar {
    background: var(--mint-200);
    color: var(--green-900);
  }
  .feat small {
    color: var(--mint-200);
  }
  .feat__note {
    padding: 16px;
    border-radius: 12px;
    background: rgba(216, 229, 224, 0.08);
    border: 1px solid rgba(216, 229, 224, 0.14);
    font-size: 14px;
    color: rgba(216, 229, 224, 0.85);
  }
  .feat__note .mono {
    display: block;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 4px;
  }
  .quote {
    padding: 28px;
  }
  .quote:last-child {
    grid-column: span 2;
  }
  blockquote {
    margin: 0;
    font-size: 15.5px;
    color: inherit;
  }
  .quote blockquote {
    color: var(--ink-2);
  }
  .stars {
    color: var(--amber);
    letter-spacing: 2px;
  }
  .quote .stars {
    color: #e0a92e;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  figcaption b {
    display: block;
    font-weight: 600;
    font-size: 15px;
  }
  figcaption small {
    display: block;
    font-size: 13px;
    color: var(--ink-3);
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--mint-100);
    color: var(--green-800);
    font-weight: 600;
  }
  @media (max-width: 960px) {
    .wall {
      grid-template-columns: 1fr 1fr;
    }
    .feat {
      grid-column: span 2;
      grid-row: auto;
    }
  }
  @media (max-width: 640px) {
    .wall {
      grid-template-columns: 1fr;
    }
    .feat,
    .quote:last-child {
      grid-column: auto;
    }
  }
</style>
