---
import { site } from '../site';

const rows = [
  { ndc: '00000-0101-01', drug: 'Atorvastatin 20 MG Tab', pkg: 90, ordered: 24, billed: 26, optum: 8, esi: 6 },
  { ndc: '00000-0102-05', drug: 'Metformin HCl 500 MG Tab', pkg: 500, ordered: 18, billed: 18, optum: 5, esi: 4 },
  { ndc: '00000-0103-10', drug: 'Lisinopril 10 MG Tab', pkg: 100, ordered: 12, billed: 15, optum: 4, esi: 3 },
  { ndc: '00000-0104-02', drug: 'Amlodipine 5 MG Tab', pkg: 90, ordered: 16, billed: 16, optum: 6, esi: 2 },
  { ndc: '00000-0105-30', drug: 'Omeprazole 20 MG Cap', pkg: 30, ordered: 10, billed: 12, optum: 3, esi: 5 },
  { ndc: '00000-0107-01', drug: 'Gabapentin 300 MG Cap', pkg: 100, ordered: 14, billed: 17, optum: 5, esi: 4 },
  { ndc: '00000-0108-12', drug: 'Levothyroxine 50 MCG Tab', pkg: 90, ordered: 11, billed: 11, optum: 4, esi: 2 },
];
const nav = ['Inventory Report', 'PBM Report', 'Billed Report', 'Aberrant Report', 'CMS Audit', 'Documents'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow"></div>
  </div>

  <div class="container hero__copy">
    <span class="eyebrow eyebrow--dark">Pharmacy audits, simplified</span>
    <h1 id="hero-title">
      Where pharmacies turn for <span class="serif">trusted</span> audit&nbsp;support
    </h1>
    <p class="hero__sub">
      BatchRx matches what you bought against what you billed, flags discrepancies before the PBM finds them, and
      puts a dedicated specialist beside you for every desktop, onsite, CMS and investigative audit.
    </p>
    <div class="hero__actions">
      <a href="#demo" class="btn btn--light">Request a demo <span class="arrow" aria-hidden="true">→</span></a>
      <a href="#pricing" class="btn btn--ghost-dark">See pricing · ${site.price}/mo</a>
    </div>
    <div class="hero__proof">
      <span class="stars" aria-hidden="true">★★★★★</span>
      <span>Trusted by <strong>400+ pharmacies</strong> in all 50 states</span>
    </div>
  </div>

  <div class="container hero__product">
    <div class="app" role="img" aria-label="BatchRx inventory report showing ordered versus billed quantities, with shortages flagged by payer">
      <div class="app__bar">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="mono app__crumb">batchrx / inventory-report</span>
        <span></span>
      </div>
      <div class="app__body">
        <aside class="app__side">
          <div class="app__brand mono">BATCHRX</div>
          {nav.map((n, i) => <div class:list={['app__nav', { 'is-active': i === 0 }]}>{n}</div>)}
        </aside>
        <div class="app__main">
          <div class="app__head">
            <div>
              <div class="app__title">Inventory Report</div>
              <div class="app__meta mono">Oct 1 – Oct 31 · all wholesalers · all payers</div>
            </div>
            <div class="app__chips">
              <span class="pill pill--red">4 need review</span>
              <span class="pill pill--green">Synced · PrimeRx</span>
            </div>
          </div>
          <div class="table" role="presentation">
            <div class="tr th mono">
              <span>NDC</span><span>Drug</span><span class="n hide-sm">Pkg</span><span class="n">Ordered</span><span class="n">Billed</span><span class="n">Shortage</span><span class="n hide-sm">Optum</span><span class="n hide-sm">ESI</span>
            </div>
            {
              rows.map((r, i) => {
                const diff = r.ordered - r.billed;
                return (
                  <div class:list={['tr', { 'is-flag': diff < 0 }]} style={`--i:${i}`}>
                    <span class="mono muted">{r.ndc}</span>
                    <span class="drug">{r.drug}</span>
                    <span class="n hide-sm">{r.pkg}</span>
                    <span class="n">{r.ordered}</span>
                    <span class="n">{r.billed}</span>
                    <span class="n">{diff < 0 ? <b class="short">{diff}</b> : <span class="ok">0</span>}</span>
                    <span class="n hide-sm">{r.optum}</span>
                    <span class="n hide-sm">{r.esi}</span>
                  </div>
                );
              })
            }
          </div>
          <div class="app__foot mono">Sample data for illustration</div>
        </div>
      </div>
    </div>

    <div class="float float--a" aria-hidden="true">
      <span class="float__icon">!</span>
      <div>
        <div class="float__title">Shortage flagged</div>
        <div class="float__text">Lisinopril 10 MG · billed 3 more than purchased</div>
      </div>
    </div>
    <div class="float float--b" aria-hidden="true">
      <span class="avatar">JS</span>
      <div>
        <div class="float__title">Audit specialist assigned</div>
        <div class="float__text">Desktop audit · documents due in 9 days</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--green-900);
    color: var(--white);
    padding-top: clamp(128px, 16vw, 176px);
    padding-bottom: 40px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 28%;
    background: var(--paper);
    z-index: -1;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(216, 229, 224, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(216, 229, 224, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 80%);
  }
  .hero__glow {
    position: absolute;
    left: 50%;
    top: 40%;
    width: 1100px;
    height: 700px;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(82, 160, 130, 0.28), transparent);
    filter: blur(20px);
  }

  .hero__copy {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 24px;
  }
  h1 {
    font-size: clamp(40px, 7vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 15ch;
  }
  h1 .serif {
    color: var(--mint-200);
    font-size: 1.08em;
  }
  .hero__sub {
    max-width: 640px;
    font-size: clamp(16px, 1.5vw, 18px);
    color: rgba(216, 229, 224, 0.82);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: rgba(216, 229, 224, 0.75);
  }
  .hero__proof strong {
    color: var(--white);
    font-weight: 500;
  }
  .stars {
    color: var(--amber);
    letter-spacing: 2px;
  }

  .hero__product {
    position: relative;
    margin-top: clamp(48px, 7vw, 80px);
    max-width: calc(1080px + var(--gutter) * 2);
    animation: rise 1s 0.15s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  .app {
    background: var(--white);
    color: var(--ink);
    border-radius: 16px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      var(--shadow-lg);
    overflow: hidden;
  }
  .app__bar {
    display: grid;
    grid-template-columns: 80px 1fr 80px;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    background: var(--mint-50);
    border-bottom: 1px solid var(--line);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d5ddd9;
  }
  .app__crumb {
    justify-self: center;
    font-size: 12px;
    color: var(--ink-3);
  }
  .app__body {
    display: grid;
    grid-template-columns: 200px 1fr;
    min-height: 420px;
  }
  .app__side {
    padding: 20px 14px;
    border-right: 1px solid var(--line);
    background: #fcfdfc;
    display: grid;
    align-content: start;
    gap: 2px;
  }
  .app__brand {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--green-800);
    padding: 0 10px 14px;
  }
  .app__nav {
    font-size: 13px;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--ink-3);
  }
  .app__nav.is-active {
    background: var(--mint-100);
    color: var(--green-800);
    font-weight: 500;
  }
  .app__main {
    padding: 22px 24px 16px;
    min-width: 0;
  }
  .app__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 18px;
  }
  .app__title {
    font-weight: 600;
    font-size: 17px;
  }
  .app__meta {
    font-size: 11px;
    color: var(--ink-3);
    margin-top: 2px;
  }
  .app__chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .table {
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    font-size: 13px;
  }
  .tr {
    display: grid;
    grid-template-columns: 120px minmax(150px, 1.6fr) repeat(6, minmax(44px, 0.5fr));
    gap: 12px;
    align-items: center;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .th {
    border-top: 0;
    background: var(--mint-50);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .n {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .muted {
    color: var(--ink-3);
    font-size: 12px;
  }
  .drug {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ok {
    color: var(--ink-3);
  }
  .short {
    display: inline-block;
    padding: 1px 8px;
    border-radius: 6px;
    background: var(--red-bg);
    color: var(--red-ink);
    font-weight: 600;
  }
  .tr.is-flag {
    animation: flag 0.6s calc(1.1s + var(--i) * 0.12s) both;
  }
  @keyframes flag {
    from {
      background: transparent;
    }
    to {
      background: #fffaf0;
    }
  }
  .app__foot {
    margin-top: 12px;
    font-size: 10.5px;
    color: var(--green-300);
  }

  .float {
    position: absolute;
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 12px 16px 12px 12px;
    background: var(--white);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
    color: var(--ink);
    max-width: 290px;
  }
  .float__title {
    font-size: 13px;
    font-weight: 600;
  }
  .float__text {
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.4;
  }
  .float__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--red-bg);
    color: var(--red-ink);
    font-weight: 700;
  }
  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--green-800);
    color: var(--white);
    font-size: 11px;
    font-weight: 600;
  }
  .float--a {
    right: calc(var(--gutter) - 56px);
    top: -30px;
    animation: pop 0.6s 1.6s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }
  .float--b {
    left: calc(var(--gutter) - 56px);
    bottom: 10%;
    animation: pop 0.6s 2s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
  }

  @media (max-width: 1180px) {
    .float--a {
      right: calc(var(--gutter) + 12px);
      top: auto;
      bottom: -24px;
    }
    .float--b {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .app__body {
      grid-template-columns: 1fr;
    }
    .app__side {
      display: none;
    }
    .hide-sm {
      display: none;
    }
    .tr {
      grid-template-columns: 0 minmax(0, 1fr) repeat(3, 56px);
      gap: 10px;
    }
    .tr > :first-child {
      display: none;
    }
    .app__main {
      padding: 16px;
    }
    .app__head {
      flex-direction: column;
    }
    .app__chips {
      justify-content: flex-start;
    }
    .app__body {
      min-height: 0;
    }
    .float--a {
      position: relative;
      right: auto;
      bottom: auto;
      margin: -20px auto 0;
    }
  }
</style>
