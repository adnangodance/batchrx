---
/**
 * CSS phone mockup. Size it with `--pw` (width); everything inside scales in em.
 */
const { class: cls, dark = false, ...rest } = Astro.props;
---

<div class:list={['phone', cls, { 'phone--dark': dark }]} aria-hidden="true" {...rest}>
  <div class="phone__screen">
    <span class="phone__island"></span>
    <div class="phone__status">
      <span>9:41</span>
      <span class="phone__sig"><i></i><i></i><i></i><b></b></span>
    </div>
    <slot />
  </div>
</div>
