---
/**
 * Version 1 footer, in the Version 6 manner: four link columns under mono
 * label chips, a ruled status bar, a full-width lowercase wordmark and a
 * closing line, on black as in Version 6.
 */
import { site } from '../site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const versions = [
  ['Version 1', `${base}/`],
  ['Version 2', `${base}/version-2`],
  ['Version 6', `${base}/version-6`],
];
---

<footer class="foot">
  <div class="foot__in">
    <div class="foot__cols">
      <div>
        <h2>Product</h2>
        <a href={`${base}/#problems`}>Audits we fix</a>
        <a href={`${base}/#approach`}>How it works</a>
        <a href={`${base}/pricing`}>Pricing</a>
        <a href={`${base}/#savings`}>Savings estimator</a>
      </div>
      <div>
        <h2>Company</h2>
        <a href={`${base}/#stories`}>Pharmacy stories</a>
        <a href={`${base}/#faq`}>FAQ</a>
        <a href={`${base}/#demo`}>Book a demo</a>
      </div>
      <div>
        <h2>Account</h2>
        <a href={site.loginUrl}>Log in</a>
        <a href={site.registerUrl}>Get started</a>
      </div>
      <div>
        <h2>Versions</h2>
        {versions.map(([t, href]) => <a href={href} aria-current={t === 'Version 1' ? 'page' : undefined}>{t}</a>)}
      </div>
    </div>

    <div class="foot__bar">
      <span class="foot__ok">HIPAA compliant · all 50 states</span>
      <nav aria-label="Legal">
        <a href={`${site.appUrl}/privacy-policy`}>Privacy Policy</a>
        <a href={`${site.appUrl}/terms-of-service`}>Terms of Service</a>
      </nav>
    </div>

    <svg class="foot__word" viewBox="0 0 1000 232" role="img" aria-label="batchrx">
      <text x="-6" y="196" font-size="262" textLength="1010" lengthAdjust="spacingAndGlyphs">batchrx</text>
    </svg>

    <div class="foot__end">
      <span>Pharmacy audit software, with a specialist for every audit.</span>
      <span>© {year} BatchRx</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    --rule: #262626;
    background: #000;
    color: #fff;
    border-top: 1px solid var(--rule);
  }
  .foot__in {
    max-width: calc(var(--wrap) + var(--pad) * 2);
    margin-inline: auto;
    padding: 48px var(--pad) 16px;
  }
  .foot__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    padding-bottom: 56px;
  }
  .foot__cols h2 {
    margin-bottom: 14px;
    padding: 4px 8px;
    background: var(--lt);
    color: #000;
    font: 400 12px/1.3 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .foot__cols a {
    display: block;
    padding: 5px 0;
    font-size: 15px;
    transition: color 0.18s;
  }
  .foot__cols a:hover,
  .foot__bar a:hover,
  .foot__cols a[aria-current] {
    color: var(--glow);
  }
  .foot__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-block: 1px solid var(--rule);
    font-size: 15px;
  }
  .foot__ok {
    color: var(--glow);
  }
  .foot__ok::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    vertical-align: 2px;
    background: var(--glow);
  }
  .foot__bar nav {
    display: flex;
    gap: 16px;
  }
  .foot__word {
    width: 100%;
    height: auto;
    margin: 22px 0 26px;
    fill: #fff;
    font-family: var(--sans);
    font-weight: 500;
  }
  .foot__end {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    color: #6f6f6f;
  }
  @media (max-width: 720px) {
    .foot__cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px 12px;
    }
  }
</style>
