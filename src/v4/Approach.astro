---
// "Our approach": three thin-line diagrams (Connect, Reconcile, Defend), Cadvel-style.
const ic = {
  rx: 'M6 4h7a4 4 0 0 1 0 8H6zM6 12v8M12 12l6 8M18 13l-6 7',
  truck: 'M2 6h12v10H2zM14 10h4l3 3v3h-7M6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  monitor: 'M3 4h18v12H3zM8 20h8M12 16v4',
  file: 'M14 3H6v18h12V7zM14 3v4h4M9 13h6M9 17h4',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-4.3-4.3',
  check: 'M5 12.5 10 17l9-10',
  alert: 'M12 4 3 19h18zM12 10v4M12 16.5h.01',
  tag: 'M4 4h7l9 9-7 7-9-9zM8 8h.01',
  pill: 'M10.5 20.5a5 5 0 0 1-7-7l10-10a5 5 0 0 1 7 7zM8.5 8.5l7 7',
};
const logo =
  'M18.39 4.53 15.7 1.84a2.6 2.6 0 0 0-3.68 0L9.34 4.53a2.6 2.6 0 0 0 0 3.67l2.69 2.69a2.6 2.6 0 0 0 3.67 0l2.69-2.69a2.6 2.6 0 0 0 0-3.67ZM10.89 12.03 8.2 9.34a2.6 2.6 0 0 0-3.67 0l-2.69 2.69a2.6 2.6 0 0 0 0 3.67l2.69 2.69a2.6 2.6 0 0 0 3.67 0l2.69-2.69a2.6 2.6 0 0 0 0-3.67ZM25.89 12.03 23.2 9.34a2.6 2.6 0 0 0-3.67 0l-2.69 2.69a2.6 2.6 0 0 0 0 3.67l2.69 2.69a2.6 2.6 0 0 0 3.67 0l2.69-2.69a2.6 2.6 0 0 0 0-3.67ZM18.39 19.53l-2.69-2.69a2.6 2.6 0 0 0-3.67 0l-2.69 2.69a2.6 2.6 0 0 0 0 3.67l2.69 2.69a2.6 2.6 0 0 0 3.67 0l2.69-2.69a2.6 2.6 0 0 0 0-3.67Z';

// small square node: centered at (x,y), size 24
const node = (x: number, y: number) => `translate(${x - 12} ${y - 12})`;

const cols = [
  {
    t: 'Connect',
    b: 'Upload files from your pharmacy system and your primary and secondary wholesalers. No new workflow and no IT project.',
  },
  {
    t: 'Reconcile',
    b: 'We match every unit purchased to every claim billed, NDC by NDC and payer by payer, and flag what an auditor would find.',
  },
  {
    t: 'Defend',
    b: 'When an audit letter arrives, your specialist works through it with you until a complete response is submitted.',
  },
];

const jag = [
  [12, 70],
  [20, 52],
  [26, 58],
  [36, 22],
  [46, 74],
  [54, 66],
  [62, 76],
  [70, 50],
  [76, 72],
  [84, 44],
  [92, 78],
  [100, 60],
  [108, 66],
];
const rise = [
  [12, 108],
  [26, 98],
  [44, 88],
  [66, 82],
  [84, 66],
  [100, 46],
  [112, 22],
];
const pathOf = (p: number[][]) => p.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ');
---

<section class="appr" id="approach" aria-labelledby="appr-h">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="kick rv">Our approach</span>
        <h2 id="appr-h" class="d2 rv" style="--d:.05s">We find it before the PBM does</h2>
      </div>
      <p class="lede rv" style="--d:.1s">
        Most pharmacies learn about a shortage when the recoupment letter arrives. We move that moment forward, then
        stay with you if an audit comes anyway.
      </p>
    </div>
  </div>

  <div class="cols">
    {
      cols.map((c, i) => (
        <article class="col rv" style={`--d:${i * 0.08}s`}>
          <div class="dia" aria-hidden="true">
            <svg viewBox="0 0 300 190" class="svg">
              <defs>
                <linearGradient id={`hub${i}`} x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#7f8c87" />
                  <stop offset="1" stop-color="#c3cbc7" />
                </linearGradient>
                <linearGradient id={`cone${i}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#dfe3e1" stop-opacity="0.9" />
                  <stop offset="1" stop-color="#dfe3e1" stop-opacity="0.15" />
                </linearGradient>
                <linearGradient id={`fill${i}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#17905e" stop-opacity="0.16" />
                  <stop offset="1" stop-color="#17905e" stop-opacity="0" />
                </linearGradient>
                <filter id={`sh${i}`} x="-30%" y="-30%" width="160%" height="160%">
                  <feDropShadow dx="0" dy="1" stdDeviation="1.2" flood-color="#0d2b27" flood-opacity="0.08" />
                </filter>
              </defs>

              {i === 0 && (
                <g>
                  <circle cx="150" cy="95" r="70" class="ring" />
                  <path d="M142 25 L158 25 L178 80 L122 80 Z" fill={`url(#cone${i})`} />
                  {[
                    [150, 25, ic.rx],
                    [80, 95, ic.truck],
                    [220, 95, ic.monitor],
                    [150, 165, ic.file],
                  ].map(([x, y, d]) => (
                    <g transform={node(x as number, y as number)} filter={`url(#sh${i})`}>
                      <rect width="24" height="24" class="tile" />
                      <g transform="translate(6 6) scale(.5)">
                        <path d={d as string} class="ic" />
                      </g>
                    </g>
                  ))}
                  <g transform="translate(132 77)" filter={`url(#sh${i})`}>
                    <rect width="36" height="36" fill={`url(#hub${i})`} />
                    <g transform="translate(9.5 9.5) scale(.6)">
                      <path d={logo} fill="#fff" />
                    </g>
                  </g>
                </g>
              )}

              {i === 1 && (
                <g>
                  <line x1="94" y1="95" x2="122" y2="95" class="ln" />
                  {[23, 59, 95, 131, 167].map((y) => (
                    <path d={`M146 95 C 186 95, 196 ${y}, 236 ${y}`} class="ln" />
                  ))}
                  <g transform="translate(58 77)" filter={`url(#sh${i})`}>
                    <rect width="36" height="36" fill={`url(#hub${i})`} />
                    <g transform="translate(9.5 9.5) scale(.6)">
                      <path d={logo} fill="#fff" />
                    </g>
                  </g>
                  <g transform={node(134, 95)} filter={`url(#sh${i})`}>
                    <rect width="24" height="24" class="tile tile--line" />
                    <g transform="translate(6 6) scale(.5)">
                      <path d={ic.search} class="ic" />
                    </g>
                  </g>
                  {[
                    [23, ic.check, false],
                    [59, ic.alert, true],
                    [95, ic.check, false],
                    [131, ic.alert, true],
                    [167, ic.check, false],
                  ].map(([y, d, bad]) => (
                    <g transform={node(248, y as number)} filter={`url(#sh${i})`}>
                      <rect width="24" height="24" class:list={['tile', { 'tile--bad': bad }]} />
                      <g transform="translate(6 6) scale(.5)">
                        <path d={d as string} class:list={['ic', { 'ic--bad': bad }]} />
                      </g>
                    </g>
                  ))}
                </g>
              )}

              {i === 2 && (
                <g>
                  <g transform="translate(14 38)">
                    <rect width="120" height="114" class="chart" />
                    {[28, 57, 86].map((y) => (
                      <line x1="0" y1={y} x2="120" y2={y} class="grid" />
                    ))}
                    {[40, 80].map((x) => (
                      <line x1={x} y1="0" x2={x} y2="114" class="grid" />
                    ))}
                    <path d={pathOf(jag)} class="jag" />
                    {jag.filter((_, k) => k % 3 === 0).map(([x, y]) => (
                      <circle cx={x} cy={y} r="2" class="pt" />
                    ))}
                  </g>
                  <line x1="134" y1="95" x2="150" y2="95" class="ln" />
                  <g transform="translate(150 77)" filter={`url(#sh${i})`}>
                    <rect width="36" height="36" fill={`url(#hub${i})`} />
                    <g transform="translate(9.5 9.5) scale(.6)">
                      <path d={logo} fill="#fff" />
                    </g>
                  </g>
                  <line x1="186" y1="95" x2="200" y2="95" class="ln" />
                  <path d="M196 91 L201 95 L196 99" class="ln" />
                  <g transform="translate(204 28)">
                    <rect width="84" height="134" class="chart chart--line" />
                    {[34, 67, 100].map((y) => (
                      <line x1="0" y1={y} x2="84" y2={y} class="grid" />
                    ))}
                    {[42].map((x) => (
                      <line x1={x} y1="0" x2={x} y2="134" class="grid" />
                    ))}
                    <path d={`${pathOf(rise.map(([x, y]) => [x * 0.66, y * 1.12]))} L74 134 L8 134 Z`} fill={`url(#fill${i})`} />
                    <path d={pathOf(rise.map(([x, y]) => [x * 0.66, y * 1.12]))} class="up" />
                    {rise.map(([x, y]) => (
                      <circle cx={x * 0.66} cy={y * 1.12} r="2.2" class="pt pt--g" />
                    ))}
                  </g>
                </g>
              )}
            </svg>
          </div>
          <div class="txt">
            <h3>{c.t}</h3>
            <p>{c.b}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .appr {
    padding-bottom: clamp(72px, 9vw, 112px);
  }
  .head {
    display: grid;
    grid-template-columns: 1fr minmax(320px, 420px);
    gap: 24px 64px;
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .head h2 {
    margin-top: 24px;
    max-width: 12ch;
    color: var(--dk);
  }
  .lede {
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* Same outer edge as the header (max 1440), not full-bleed */
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1440px;
    margin-inline: auto;
    border: 1px solid var(--line);
    background: var(--card);
  }
  .col {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .col + .col {
    border-left: 1px solid var(--line);
  }
  .dia {
    position: relative;
    display: grid;
    place-items: center;
    height: 290px;
    padding: 16px;
    background:
      linear-gradient(rgba(255, 255, 255, 0.75) 1px, transparent 1px) -1px -1px / 48px 48px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.75) 1px, transparent 1px) -1px -1px / 48px 48px,
      #f2f2f0;
    overflow: hidden;
  }
  .dia::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(closest-side, rgba(242, 242, 240, 0), rgba(242, 242, 240, 0.85));
    pointer-events: none;
  }
  .svg {
    position: relative;
    z-index: 1;
    width: min(100%, 360px);
    height: auto;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: #d9dcda;
    stroke-width: 1;
  }
  .tile {
    fill: #fff;
  }
  .tile--line {
    stroke: #d3d6d4;
    stroke-width: 1;
  }
  .tile--bad {
    fill: #fff4f1;
  }
  .ic {
    fill: none;
    stroke: var(--dk);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ic--bad {
    stroke: var(--bad);
  }
  .ln {
    fill: none;
    stroke: #cdd1cf;
    stroke-width: 1;
  }
  .chart {
    fill: #fff;
  }
  .chart--line {
    stroke: #c9cdcb;
    stroke-width: 1;
  }
  .grid {
    stroke: #eceeed;
    stroke-width: 1;
  }
  .jag {
    fill: none;
    stroke: #a9b1ae;
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .up {
    fill: none;
    stroke: var(--ok);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .pt {
    fill: #fff;
    stroke: #a9b1ae;
    stroke-width: 1;
  }
  .pt--g {
    stroke: var(--ok);
  }

  .txt {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 28px 30px 36px;
    border-top: 1px solid var(--line);
  }
  .txt h3 {
    font-size: 26px;
    font-weight: 400;
    letter-spacing: -0.035em;
    color: var(--dk);
  }
  .txt p {
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 46ch;
  }

  @media (max-width: 960px) {
    .head {
      grid-template-columns: 1fr;
    }
    .cols {
      grid-template-columns: 1fr;
      border-inline: 0;
    }
    .col + .col {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .dia {
      height: 240px;
    }
    .txt {
      padding: 22px var(--pad) 28px;
    }
  }
</style>
