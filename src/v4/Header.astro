---
import Arrow from './Arrow.astro';
import { site } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: '#problems', label: 'Audits we fix' },
  { href: '#approach', label: 'How it works' },
  { href: '#plan', label: 'Pricing' },
  { href: '#stories', label: 'Pharmacies' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="hd on-dk" data-hd>
  <div class="hd__in">
    <a href={`${base}/`} class="hd__logo" aria-label="BatchRx home">
      <svg width="30" height="30" viewBox="0 0 27.7279 27.7279" fill="none" aria-hidden="true"
        ><path
          d="M18.39 4.53 15.7 1.84a2.6 2.6 0 0 0-3.68 0L9.34 4.53a2.6 2.6 0 0 0 0 3.67l2.69 2.69a2.6 2.6 0 0 0 3.67 0l2.69-2.69a2.6 2.6 0 0 0 0-3.67ZM10.89 12.03 8.2 9.34a2.6 2.6 0 0 0-3.67 0l-2.69 2.69a2.6 2.6 0 0 0 0 3.67l2.69 2.69a2.6 2.6 0 0 0 3.67 0l2.69-2.69a2.6 2.6 0 0 0 0-3.67ZM25.89 12.03 23.2 9.34a2.6 2.6 0 0 0-3.67 0l-2.69 2.69a2.6 2.6 0 0 0 0 3.67l2.69 2.69a2.6 2.6 0 0 0 3.67 0l2.69-2.69a2.6 2.6 0 0 0 0-3.67ZM18.39 19.53l-2.69-2.69a2.6 2.6 0 0 0-3.67 0l-2.69 2.69a2.6 2.6 0 0 0 0 3.67l2.69 2.69a2.6 2.6 0 0 0 3.67 0l2.69-2.69a2.6 2.6 0 0 0 0-3.67Z"
          fill="#F2F5F3"></path></svg
      >
      <span>BatchRx</span>
    </a>
    <nav class="hd__nav" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="hd__cta">
      <a href={site.loginUrl} class="hd__login">Log in</a>
      <a href="#demo" class="btn btn--sm">
        <span class="btn__l">Book a demo</span><span class="btn__a"><Arrow /></span>
      </a>
      <button class="hd__burger" aria-label="Open menu" aria-expanded="false" aria-controls="m-menu" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="hd__menu" id="m-menu" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={site.loginUrl}>Log in</a>
  </div>
</header>

<script>
  const hd = document.querySelector<HTMLElement>('[data-hd]')!;
  const b = hd.querySelector<HTMLButtonElement>('[data-burger]')!;
  const m = hd.querySelector<HTMLElement>('#m-menu')!;
  const set = (open: boolean) => {
    m.hidden = !open;
    b.setAttribute('aria-expanded', String(open));
    b.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    hd.classList.toggle('is-open', open);
  };
  b.addEventListener('click', () => set(m.hasAttribute('hidden')));
  m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
</script>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid var(--dk-line);
  }
  .hd__in {
    display: grid;
    grid-template-columns: 290px 1fr auto;
    align-items: stretch;
    height: 80px;
    max-width: 1440px;
    margin-inline: auto;
  }
  .hd__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-inline: 40px;
    border-right: 1px solid var(--dk-line);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.05em;
  }
  .hd__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
  }
  .hd__nav a {
    font-size: 15px;
    color: rgba(242, 245, 243, 0.82);
    transition: color 0.2s;
  }
  .hd__nav a:hover {
    color: #fff;
  }
  .hd__cta {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-inline: 40px;
    border-left: 1px solid var(--dk-line);
  }
  .hd__login {
    font-size: 15px;
    color: rgba(242, 245, 243, 0.82);
  }
  .hd__login:hover {
    color: #fff;
  }
  .hd__burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid var(--dk-line-2);
    background: none;
    cursor: pointer;
  }
  .hd__burger span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.5px;
    background: #fff;
    transition: transform 0.25s var(--ease);
  }
  .hd__burger span:first-child {
    top: 18px;
  }
  .hd__burger span:last-child {
    top: 24px;
  }
  .is-open .hd__burger span:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  .is-open .hd__burger span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }
  .hd__menu[hidden] {
    display: none;
  }
  .hd__menu {
    display: grid;
    border-top: 1px solid var(--dk-line);
  }
  .hd__menu a {
    padding: 18px var(--pad);
    border-bottom: 1px solid var(--dk-line);
    font-size: 18px;
  }
  @media (max-width: 1100px) {
    .hd__in {
      grid-template-columns: auto 1fr;
    }
    .hd__nav,
    .hd__login {
      display: none;
    }
    .hd__logo {
      padding-inline: var(--pad);
      border-right: 0;
      font-size: 26px;
    }
    .hd__cta {
      justify-content: flex-end;
      gap: 12px;
      padding-inline: var(--pad);
      border-left: 0;
    }
    .hd__burger {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .hd__cta .btn {
      display: none;
    }
    .hd__in {
      height: 68px;
    }
  }
</style>
