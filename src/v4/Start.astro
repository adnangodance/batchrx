---
/**
 * "Get started" block, after Version 6: a centred label chip, headline, two
 * flat buttons and a mono note, over a ruled row of numbered stats.
 */
import { site, stats } from '../site';

const fmt = (s: (typeof stats)[number]) =>
  `${'prefix' in s ? (s.prefix ?? '') : ''}${s.value.toLocaleString('en-US')}${s.suffix ?? ''}`;
---

<section class="go" id="start" aria-labelledby="go-h">
  <div class="wrap">
    <span class="go__chip rv">Get started</span>
    <h2 class="go__h rv" id="go-h" style="--d:.05s">Built for audits. Ready for the letter.</h2>
    <div class="go__cta rv" style="--d:.1s">
      <a href={site.registerUrl} class="go__btn">Start now</a>
      <a href="#demo" class="go__btn go__btn--ghost">Talk to a specialist</a>
    </div>
    <p class="go__mono go__note rv" style="--d:.14s">
      ${site.price}/month per pharmacy · Specialist included · HIPAA compliant
    </p>

    <div class="go__stats">
      {
        stats.map((s, i) => (
          <div>
            <span class="go__mono">{String(i + 1).padStart(3, '0')}</span>
            <b>{fmt(s)}</b>
            <span class="go__mono">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .go {
    padding-top: clamp(56px, 7vw, 96px);
    background: #fff;
    text-align: center;
  }
  .go__mono {
    font: 400 12px/1.35 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .go__chip {
    display: inline-block;
    min-width: 138px;
    padding: 4px 8px;
    background: var(--lt-2);
    color: var(--ink);
    font: 400 12px/1.3 var(--mono);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .go__chip::before {
    content: ':: ';
    opacity: 0.7;
  }
  .go__h {
    max-width: 16ch;
    margin: 22px auto 26px;
    font-size: clamp(34px, 4.6vw, 64px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .go__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .go__btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-width: 180px;
    padding: 10px 14px;
    border: 1px solid var(--dk);
    background: var(--dk);
    color: #fff;
    font-size: 15px;
    line-height: 1.2;
    text-align: left;
    transition:
      background 0.18s,
      color 0.18s,
      border-color 0.18s;
  }
  .go__btn::after {
    content: '';
    border: 4px solid transparent;
    border-left: 6px solid currentColor;
    border-right: 0;
    transition: transform 0.18s;
  }
  .go__btn:hover {
    border-color: var(--glow);
    background: var(--glow);
    color: var(--dk);
  }
  .go__btn:hover::after {
    transform: translateX(3px);
  }
  .go__btn--ghost {
    border-color: var(--line-2);
    background: #fff;
    color: var(--dk);
  }
  .go__btn--ghost:hover {
    border-color: var(--line-2);
    background: var(--lt);
  }
  .go__note {
    margin-top: 16px;
  }

  .go__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(40px, 5vw, 72px);
    text-align: left;
  }
  .go__stats > div {
    display: flex;
    flex-direction: column;
    min-height: clamp(190px, 20vw, 280px);
    padding: 0 0 12px 24px;
    border-left: 1px solid var(--line);
  }
  .go__stats .go__mono:first-child {
    color: var(--ink-4);
  }
  .go__stats b {
    margin-top: auto;
    font-size: clamp(38px, 4.5vw, 66px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .go__stats .go__mono:last-child {
    margin-top: 8px;
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .go__stats {
      grid-template-columns: 1fr 1fr;
      row-gap: 28px;
    }
    .go__stats > div {
      min-height: 130px;
      padding-left: 14px;
    }
  }
</style>
