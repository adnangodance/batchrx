---
import Arrow from './Arrow.astro';
import { site } from '../site';
const why = [
  'One flat price: every report, every audit tool and a specialist for every audit.',
  'Works with PrimeRx, Pioneer, Datascan, DigitalRx, BestRx, Liberty and all wholesalers.',
  'Desktop, onsite, CMS and investigative audits, all covered by the same plan.',
  'HIPAA compliant, serving independent and multi-store pharmacies in all 50 states.',
];
---

<section class="plan on-dk" id="plan" aria-labelledby="plan-h">
  <div class="wrap">
    <div class="frame">
      <div class="top">
        <span class="kick rv">One plan</span>
        <h2 id="plan-h" class="d2 rv" style="--d:.05s">Software and specialists, in one simple plan</h2>
        <p class="body rv" style="--d:.1s">
          ${site.price} per month. Billed monthly, no setup fees, cancel anytime. No tiers and no per-audit charges.
        </p>
      </div>

      <div class="cards">
        <article class="card rv">
          <div class="icon icon--dots" aria-hidden="true"><i></i><i></i><i class="g"></i><i></i></div>
          <h3>The platform</h3>
          <p class="body">
            Inventory, PBM, billed and aberrant reports, controlled substance tracking, BIN search, supplier and tag
            management, and document storage organized by audit.
          </p>
          <a href="#demo" class="link">See it in a demo</a>
        </article>
        <article class="card rv" style="--d:.08s">
          <div class="icon icon--bars" aria-hidden="true">
            <i class="g"></i><i class="g"></i><i class="g"></i><i class="g"></i><i></i><i></i><i></i>
          </div>
          <h3>Audit assistance</h3>
          <p class="body">
            A dedicated specialist works one-on-one with you through every desktop, onsite, CMS and investigative audit,
            from the letter to the final response.
          </p>
          <a href="#demo" class="link">Talk to a specialist</a>
        </article>
        <article class="card card--price rv" style="--d:.16s">
          <span class="kick">All-in-One Plan</span>
          <div class="price">
            <span class="tnum">${site.price}</span><small>/ month</small>
          </div>
          <ul>
            <li>Billed monthly</li>
            <li>No setup fees</li>
            <li>Cancel anytime</li>
          </ul>
          <a href="#demo" class="btn">
            <span class="btn__l">Book a demo</span><span class="btn__a"><Arrow /></span>
          </a>
        </article>
      </div>

      <div class="hatch" aria-hidden="true"></div>

      <div class="why">
        <h3 class="rv">Why pharmacies choose BatchRx</h3>
        <ul>
          {
            why.map((w, i) => (
              <li class="rv" style={`--d:${i * 0.06}s`}>
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M3 8.5 6.5 12 13 4.5" />
                </svg>
                <p>{w}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .plan {
    padding-block: 32px 64px;
  }
  .frame {
    border-left: 1px solid var(--dk-line);
    border-right: 1px solid var(--dk-line);
  }
  .top {
    display: grid;
    gap: 24px;
    padding: clamp(48px, 6vw, 80px) clamp(20px, 3vw, 40px) clamp(40px, 5vw, 64px);
    border-bottom: 1px solid var(--dk-line);
  }
  .top h2 {
    max-width: 16ch;
  }
  .top .body {
    font-size: 15px;
    max-width: 60ch;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr 0.9fr;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(24px, 3vw, 40px);
    min-height: 380px;
  }
  .card + .card {
    border-left: 1px solid var(--dk-line);
  }
  .icon {
    margin-bottom: auto;
  }
  .icon--dots {
    display: grid;
    grid-template-columns: repeat(2, 18px);
    gap: 2px;
  }
  .icon--dots i {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(232, 240, 236, 0.32);
  }
  .icon i.g {
    background: var(--glow);
  }
  .icon--bars {
    display: flex;
    gap: 4px;
    height: 32px;
  }
  .icon--bars i {
    width: 6px;
    background: rgba(232, 240, 236, 0.32);
  }
  .card h3 {
    margin-top: 48px;
    font-size: clamp(26px, 2.4vw, 34px);
    font-weight: 400;
    letter-spacing: -0.035em;
  }
  .card .body {
    font-size: 15px;
    max-width: 44ch;
  }
  .card .link {
    margin-top: 12px;
    width: fit-content;
  }
  .card--price {
    background: var(--dk-2);
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: auto;
  }
  .price span {
    font-size: clamp(64px, 7vw, 96px);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 1;
    color: #fff;
  }
  .price small {
    font-size: 15px;
    color: var(--dk-txt);
  }
  .card--price ul {
    display: grid;
    gap: 6px;
    font-size: 14.5px;
    color: var(--dk-txt);
  }
  .card--price li::before {
    content: '✓';
    margin-right: 10px;
    color: var(--glow);
  }
  .card--price .btn {
    margin-top: 12px;
    align-self: flex-start;
  }
  .hatch {
    height: 22px;
    border-block: 1px solid var(--dk-line);
    background: repeating-linear-gradient(-45deg, transparent 0 6px, rgba(232, 240, 236, 0.08) 6px 7px);
  }
  .why {
    padding: clamp(40px, 5vw, 56px) clamp(20px, 3vw, 40px) 0;
  }
  .why h3 {
    font-size: clamp(26px, 2.4vw, 34px);
    font-weight: 400;
    letter-spacing: -0.035em;
    margin-bottom: 32px;
  }
  .why ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--dk-line);
  }
  .why li {
    display: grid;
    gap: 24px;
    align-content: start;
    padding: 20px 20px 28px;
    font-size: 14.5px;
    line-height: 1.5;
    color: rgba(242, 245, 243, 0.86);
  }
  .why li + li {
    border-left: 1px solid var(--dk-line);
  }
  .why svg {
    color: var(--glow);
  }
  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .card + .card {
      border-left: 0;
      border-top: 1px solid var(--dk-line);
    }
    .card {
      min-height: 0;
    }
    .card h3 {
      margin-top: 28px;
    }
    .why ul {
      grid-template-columns: 1fr 1fr;
    }
    .why li:nth-child(3) {
      border-left: 0;
    }
    .why li:nth-child(n + 3) {
      border-top: 1px solid var(--dk-line);
    }
  }
  @media (max-width: 560px) {
    .why ul {
      grid-template-columns: 1fr;
    }
    .why li + li {
      border-left: 0;
      border-top: 1px solid var(--dk-line);
    }
    .frame {
      border: 0;
    }
  }
</style>
