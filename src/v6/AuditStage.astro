---
/**
 * 5-Audit Interactive Clinical Visual Stage.
 * Architectural left tab rail + high-contrast live visual stage on the right.
 */
const audits = [
  {
    id: 'inv',
    num: '01',
    tab: 'Invoice shortages',
    title: 'Shortages cost the most when a PBM finds them first.',
    copy: 'PBMs compare what you billed against what your primary wholesaler reported. BatchRx runs that comparison every month across primary and secondary wholesalers so gaps are resolved before they become clawbacks.',
    tag: 'Inventory Report',
  },
  {
    id: 'desk',
    num: '02',
    tab: 'Desktop audits',
    title: 'Pull every prescription, invoice, and signature in minutes.',
    copy: 'Desktop audits fail when pharmacies miss deadlines or submit incomplete packets. BatchRx indexes every claim and pairs you with a specialist to assemble and review your submission.',
    tag: 'Desktop Defense',
  },
  {
    id: 'onsite',
    num: '03',
    tab: 'OnSite audits',
    title: 'Know what an auditor will find before they walk in.',
    copy: 'Walk into every on-site inspection knowing your exact purchase-to-bill match rate, signature completeness, and supplier trail across every audited drug.',
    tag: 'OnSite Readiness',
  },
  {
    id: 'abr',
    num: '04',
    tab: 'Aberrant & BIN claims',
    title: 'Spot outlier claims before they put you on an audit list.',
    copy: 'Search any BIN number in seconds, flag unusual quantity or refill patterns early, and keep your pharmacy off PBM investigative target lists.',
    tag: 'Aberrant Report',
  },
  {
    id: 'ctrl',
    num: '05',
    tab: 'Controlled substances',
    title: 'Schedule II–V perpetual accountability without spreadsheets.',
    copy: 'Track controlled substance purchases, billed fills, and reverse distributor returns in one defensible audit trail.',
    tag: 'Controlled Report',
  },
];
---

<div class="stage-box" data-stage>
  <div class="stage__rail" role="tablist" aria-label="Five audit scenarios">
    {
      audits.map((a, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-st-tab={a.id}>
          <span class="mono">{a.num}</span>
          <b>{a.tab}</b>
        </button>
      ))
    }
  </div>

  <div class="stage__body">
    {
      audits.map((a, i) => (
        <div class:list={['stage__panel', { 'is-on': i === 0 }]} data-st-panel={a.id}>
          <div class="stage__copy">
            <span class="mono">{a.num} · {a.tag}</span>
            <h3 class="d3">{a.title}</h3>
            <p class="body">{a.copy}</p>
            <a href="#demo" class="stage__link">See {a.tag.toLowerCase()} in a demo →</a>
          </div>

          <div class="stage__viz" aria-hidden="true">
            {a.id === 'inv' && (
              <div class="viz-card">
                <div class="viz__h"><b>Purchased vs. billed</b><em class="vtag vtag--bad">2 shortages</em></div>
                <div class="vbar-list">
                  <div class="vbar"><span>Lisinopril 10 mg</span><i><b style="width:78%"></b></i><em class="neg">−30</em></div>
                  <div class="vbar"><span>Omeprazole 20 mg</span><i><b style="width:82%"></b></i><em class="neg">−20</em></div>
                  <div class="vbar"><span>Atorvastatin 20 mg</span><i><b class="ok" style="width:100%"></b></i><em class="pos">0</em></div>
                  <div class="vbar"><span>Metformin 500 mg</span><i><b class="ok" style="width:100%"></b></i><em class="pos">0</em></div>
                </div>
                <div class="viz__f mono"><span>Recovered via secondary invoice</span><b>+$1,950</b></div>
              </div>
            )}

            {a.id === 'desk' && (
              <div class="viz-card">
                <div class="viz__h"><b>Express Scripts · Desktop</b><em class="vtag vtag--warn">9 days left</em></div>
                <ul class="vcheck">
                  <li class="on">26 requested Rx claims extracted</li>
                  <li class="on">Kinray + Real Value invoices linked</li>
                  <li class="on">Patient pickup signatures verified</li>
                  <li class="on">Dedicated specialist final sign-off</li>
                </ul>
                <div class="viz__f mono"><span>Packet completeness</span><b>100% ready</b></div>
              </div>
            )}

            {a.id === 'onsite' && (
              <div class="viz-card">
                <div class="viz__h"><b>Pre-visit readiness</b><em class="vtag vtag--ok">Audit-ready</em></div>
                <div class="vgrid">
                  <div><small>NDC match rate</small><b>99.2%</b></div>
                  <div><small>Hard copies</small><b>100%</b></div>
                  <div><small>Copay logs</small><b>Verified</b></div>
                  <div><small>Specialist</small><b>On call</b></div>
                </div>
                <div class="viz__f mono"><span>Zero surprise findings</span><b>CMS &amp; PBM</b></div>
              </div>
            )}

            {a.id === 'abr' && (
              <div class="viz-card">
                <div class="viz__h"><b>BIN 610014 · Outlier scan</b><em class="vtag vtag--bad">2 flags</em></div>
                <div class="vrows">
                  <div><span>Early refill pattern</span><em class="mono neg">Rx 4410923</em></div>
                  <div><span>Quantity above 95th pct</span><em class="mono neg">Rx 4411278</em></div>
                  <div><span>Days supply check</span><em class="mono pos">Cleared</em></div>
                </div>
                <div class="viz__f mono"><span>Claims scanned</span><b>1,904 in 0.4s</b></div>
              </div>
            )}

            {a.id === 'ctrl' && (
              <div class="viz-card">
                <div class="viz__h"><b>Controlled C-II ledger</b><em class="vtag vtag--ok">Balanced</em></div>
                <div class="vrows">
                  <div><span>Primary + secondary receipts</span><em class="mono pos">420 units</em></div>
                  <div><span>Dispensed &amp; billed claims</span><em class="mono">408 units</em></div>
                  <div><span>Reverse distributor returns</span><em class="mono pos">12 units</em></div>
                </div>
                <div class="viz__f mono"><span>Net variance</span><b>0 units</b></div>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const st = document.querySelector<HTMLElement>('[data-stage]');
  if (st) {
    const tabs = [...st.querySelectorAll<HTMLButtonElement>('[data-st-tab]')];
    const panels = [...st.querySelectorAll<HTMLElement>('[data-st-panel]')];
    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.stTab!;
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
        panels.forEach((p) => p.classList.toggle('is-on', p.dataset.stPanel === id));
      });
    });
  }
</script>

<style>
  .stage-box {
    border: 1px solid var(--line-2);
    background: var(--white);
  }

  .stage__rail {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-bottom: 1px solid var(--line-2);
    background: var(--stone);
  }

  .stage__rail button {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 18px;
    border: 0;
    border-right: 1px solid var(--line);
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: var(--ink-3);
    transition:
      background-color 0.16s,
      color 0.16s;
  }

  .stage__rail button:last-child {
    border-right: 0;
  }

  .stage__rail button span {
    font-size: 11px;
    opacity: 0.7;
  }

  .stage__rail button b {
    font-size: 13.5px;
    font-weight: 500;
  }

  .stage__rail button[aria-selected='true'] {
    background: var(--white);
    color: var(--ink);
    box-shadow: inset 0 2px 0 var(--dk);
  }

  .stage__panel {
    display: none;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    min-height: 360px;
  }

  .stage__panel.is-on {
    display: grid;
  }

  .stage__copy {
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    border-right: 1px solid var(--line);
  }

  .stage__copy > span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand);
  }

  .stage__link {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--line-2);
  }

  .stage__link:hover {
    text-decoration-color: var(--ok);
  }

  .stage__viz {
    padding: clamp(26px, 3.6vw, 44px);
    background:
      radial-gradient(380px 260px at 60% 45%, rgba(56, 217, 139, 0.16), transparent 70%),
      linear-gradient(rgba(226, 240, 234, 0.04) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgba(226, 240, 234, 0.04) 1px, transparent 1px) 0 0 / 32px 32px,
      var(--dk);
    display: grid;
    place-items: center;
  }

  .viz-card {
    width: 100%;
    max-width: 460px;
    background: #ffffff;
    color: var(--ink);
    padding: 20px 22px;
    box-shadow: 0 24px 50px -16px rgba(0, 0, 0, 0.5);
    display: grid;
    gap: 16px;
  }

  .viz__h {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid #e6eae8;
    font-size: 14px;
  }

  .vtag {
    font-style: normal;
    font-family: var(--mono);
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 2px;
  }

  .vtag--bad {
    background: var(--bad-bg);
    color: var(--bad);
  }

  .vtag--ok {
    background: var(--ok-bg);
    color: var(--ok);
  }

  .vtag--warn {
    background: var(--warn-bg);
    color: var(--warn);
  }

  .vbar-list,
  .vrows {
    display: grid;
    gap: 10px;
  }

  .vbar {
    display: grid;
    grid-template-columns: 128px 1fr 34px;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
  }

  .vbar i {
    display: block;
    height: 7px;
    background: #edf0ee;
  }

  .vbar i b {
    display: block;
    height: 100%;
    background: var(--bad);
  }

  .vbar i b.ok {
    background: var(--ok);
  }

  .vbar em,
  .vrows em {
    font-style: normal;
    text-align: right;
    font-size: 12px;
    font-weight: 600;
  }

  .neg {
    color: var(--bad);
  }

  .pos {
    color: var(--ok);
  }

  .vrows div {
    display: flex;
    justify-content: space-between;
    padding: 8px 10px;
    background: #f6f8f7;
    font-size: 12.5px;
  }

  .vcheck {
    display: grid;
    gap: 8px;
  }

  .vcheck li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .vcheck li::before {
    content: '✓';
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ok-bg);
    color: var(--ok);
    font-size: 11px;
    font-weight: 700;
    flex: none;
  }

  .vgrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .vgrid div {
    padding: 12px;
    background: #f6f8f7;
    border: 1px solid #e7ece9;
  }

  .vgrid small {
    display: block;
    font-size: 11px;
    color: var(--ink-3);
  }

  .vgrid b {
    font-size: 18px;
    font-weight: 600;
  }

  .viz__f {
    display: flex;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid #e6eae8;
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .viz__f b {
    color: var(--ok);
  }

  @media (max-width: 980px) {
    .stage__rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stage__panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .stage__copy {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
