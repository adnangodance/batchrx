---
import { site } from '../site';
const RATE = 0.035;
const VALUE = 175;
const START = 4450;
const STORES = [1, 2, 4, 8, 12];
---

<div class="roi" data-roi data-rate={RATE} data-value={VALUE} data-price={site.price}>
  <div class="roi__left">
    <div class="roi__ctrl">
      <div class="roi__head">
        <label for="v6-rx">Monthly prescriptions per store</label>
        <output for="v6-rx" class="mono tnum" data-o="rx">4,450</output>
      </div>
      <input id="v6-rx" type="range" min="100" max="10000" step="50" value={START} data-rx />
      <div class="roi__ticks mono" aria-hidden="true">
        <span>100</span><span>2,500</span><span>5,000</span><span>7,500</span><span>10,000+</span>
      </div>
    </div>

    <div class="roi__ctrl">
      <div class="roi__head">
        <span>Pharmacy locations</span>
        <strong class="mono" data-o="stores">1 pharmacy</strong>
      </div>
      <div class="roi__stores" role="group" aria-label="Number of pharmacy locations">
        {
          STORES.map((n, i) => (
            <button type="button" class:list={[{ 'is-on': i === 0 }]} data-st={n}>
              {n === 12 ? '12+' : n}
            </button>
          ))
        }
      </div>
    </div>

    <div class="roi__ratio">
      <div class="roi__rhead">
        <span>Flat BatchRx plan vs. protected revenue</span>
        <b class="mono" data-o="mult-chip">78× ROI</b>
      </div>
      <div class="roi__bar">
        <i class="is-cost" data-o="cbar" style="width: 3%"></i>
        <i class="is-save"></i>
      </div>
      <div class="roi__rfoot mono">
        <span>Plan: <b data-o="cost">$350/mo</b></span>
        <span>Protected: <b data-o="save-sm">$27,256/mo</b></span>
      </div>
    </div>
  </div>

  <div class="roi__right">
    <div>
      <span class="mono">Estimated recoupments prevented</span>
      <strong class="tnum" data-o="mo">$27,256<small>/mo</small></strong>
      <p>Approximately <b class="tnum" data-o="yr">$327,072 / year</b> kept out of PBM clawbacks.</p>
    </div>

    <div class="roi__grid">
      <div>
        <small>Discrepancies caught / mo</small>
        <b class="mono tnum" data-o="disc">155.8</b>
      </div>
      <div>
        <small>Return vs. $350 plan</small>
        <b class="mono tnum" data-o="mult">78×</b>
      </div>
    </div>

    <div class="roi__foot">
      <a href="#demo" class="btn btn--glow" style="width: 100%">
        See what BatchRx catches in your claims
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
      </a>
      <p class="roi__note">
        Uses the industry-average 3.5% PBM audit discrepancy rate and $175 at risk per discrepancy. Your results will vary.
      </p>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-roi]');
  if (root) {
    const rate = Number(root.dataset.rate);
    const val = Number(root.dataset.value);
    const price = Number(root.dataset.price);
    const range = root.querySelector<HTMLInputElement>('[data-rx]')!;
    const sBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-st]')];
    const o = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const f = (n: number) => n.toLocaleString('en-US');
    let stores = 1;

    const upd = () => {
      const rx = Number(range.value);
      const d = rx * rate * stores;
      const mo = Math.round(d * val);
      const yr = mo * 12;
      const cost = price * stores;
      const mult = Math.max(1, Math.round(mo / cost));
      const p = ((rx - 100) / 9900) * 100;
      const ratio = Math.max(2, Math.min(25, (cost / Math.max(mo, 1)) * 100));

      range.style.setProperty('--p', `${p}%`);
      o('rx').textContent = rx >= 10000 ? '10,000+' : f(rx);
      o('stores').textContent = stores === 1 ? '1 pharmacy' : `${stores === 12 ? '12+' : stores} pharmacies`;
      o('disc').textContent = d.toFixed(1);
      o('mo').innerHTML = `$${f(mo)}<small>/mo</small>`;
      o('yr').textContent = `$${f(yr)} / year`;
      o('mult').textContent = `${mult}×`;
      o('mult-chip').textContent = `${mult}× ROI`;
      o('cost').textContent = `$${f(cost)}/mo`;
      o('save-sm').textContent = `$${f(mo)}/mo`;
      o('cbar').style.width = `${ratio}%`;
    };

    range.addEventListener('input', upd);
    sBtns.forEach((b) => {
      b.addEventListener('click', () => {
        stores = Number(b.dataset.st);
        sBtns.forEach((x) => x.classList.toggle('is-on', x === b));
        upd();
      });
    });
    upd();
  }
</script>

<style>
  .roi {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    border: 1px solid var(--line-2);
    background: var(--white);
  }

  .roi__left {
    padding: clamp(26px, 3.6vw, 44px);
    display: grid;
    gap: 28px;
    align-content: center;
  }

  .roi__ctrl {
    display: grid;
    gap: 12px;
  }

  .roi__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .roi__head label,
  .roi__head span {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .roi__head output {
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .roi__head strong {
    font-size: 13px;
    color: var(--brand);
  }

  input[type='range'] {
    --p: 44%;
    appearance: none;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--dk) var(--p), #d7ddd9 var(--p));
    cursor: pointer;
  }

  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 18px;
    height: 18px;
    background: var(--dk);
    border: 2px solid #ffffff;
    box-shadow: 0 0 0 1px var(--dk);
  }

  input[type='range']::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 0;
    background: var(--dk);
    border: 2px solid #ffffff;
  }

  .roi__ticks {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--ink-4);
  }

  .roi__stores {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
  }

  .roi__stores button {
    height: 40px;
    border: 1px solid var(--line-2);
    background: var(--stone);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .roi__stores button.is-on {
    background: var(--dk);
    border-color: var(--dk);
    color: #ffffff;
  }

  .roi__ratio {
    padding: 16px;
    background: var(--stone);
    border: 1px solid var(--line);
    display: grid;
    gap: 10px;
  }

  .roi__rhead,
  .roi__rfoot {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--ink-2);
  }

  .roi__rhead b {
    color: var(--ok);
  }

  .roi__bar {
    display: flex;
    gap: 2px;
    height: 8px;
  }

  .is-cost {
    background: var(--dk);
    transition: width 0.25s var(--ease);
  }

  .is-save {
    flex: 1;
    background: var(--glow);
  }

  .roi__right {
    padding: clamp(26px, 3.6vw, 44px);
    background:
      radial-gradient(400px 300px at 90% 10%, rgba(56, 217, 139, 0.16), transparent 70%),
      var(--dk);
    color: #f0f6f3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .roi__right > div > span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--glow);
  }

  .roi__right strong {
    display: block;
    margin-top: 8px;
    font-size: clamp(46px, 4.6vw, 64px);
    font-weight: 420;
    letter-spacing: -0.045em;
    line-height: 0.96;
    color: #ffffff;
  }

  .roi__right strong :global(small) {
    font-size: 18px;
    font-weight: 400;
    color: var(--dk-txt);
    margin-left: 4px;
  }

  .roi__right > div > p {
    margin-top: 10px;
    font-size: 14px;
    color: var(--dk-txt);
  }

  .roi__right > div > p b {
    color: var(--glow);
    font-weight: 500;
  }

  .roi__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--dk-line);
    border: 1px solid var(--dk-line);
  }

  .roi__grid div {
    background: var(--dk);
    padding: 14px 16px;
  }

  .roi__grid small {
    display: block;
    font-size: 11.5px;
    color: var(--dk-txt);
  }

  .roi__grid b {
    display: block;
    margin-top: 4px;
    font-size: 24px;
    font-weight: 500;
    color: #ffffff;
  }

  .roi__foot {
    display: grid;
    gap: 10px;
  }

  .roi__note {
    font-size: 11.5px;
    color: var(--dk-mut);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .roi {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
