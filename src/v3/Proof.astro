---
import { payers } from '../site';
const stats = [
  { v: 50, pre: '$', suf: 'M+', l: 'in audit recoupments saved' },
  { v: 13500, suf: '+', l: 'audits generated' },
  { v: 400, suf: '+', l: 'active pharmacies' },
  { v: 50, suf: '', l: 'states served' },
];
---

<section class="proof" id="proof" aria-label="Proof">
  <div class="wrap">
    <p class="proof__lbl">Helping pharmacies through audits from</p>
    <ul class="payers" aria-label={payers.join(', ')}>
      {payers.map((p) => <li aria-hidden="true">{p}</li>)}
    </ul>

    <dl class="stats">
      {
        stats.map((s, i) => (
          <div class="stat rv" style={`--d:${i * 0.06}s`}>
            <dd class="stat__v tnum">
              {s.pre}
              <span data-cnt={s.v}>{s.v.toLocaleString('en-US')}</span>
              {s.suf}
            </dd>
            <dt class="stat__l">{s.l}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        if (reduce) return;
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.cnt);
        const t0 = performance.now();
        const step = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = Math.round(end * (1 - Math.pow(1 - p, 4))).toLocaleString('en-US');
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }),
    { threshold: 0.6 },
  );
  document.querySelectorAll('.proof [data-cnt]').forEach((el) => io.observe(el));
</script>

<style>
  .proof {
    padding-block: clamp(48px, 6vw, 72px) clamp(72px, 9vw, 112px);
  }
  .proof__lbl {
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-3);
    margin-bottom: 28px;
  }
  .payers {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .payers li {
    display: grid;
    place-items: center;
    height: 76px;
    padding: 0 12px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #8b9893;
    text-align: center;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .payers li:hover {
    color: var(--ink);
    background: var(--bg-soft);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: clamp(56px, 7vw, 88px);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 20px;
    border-left: 2px solid var(--b-100);
  }
  .stat__v {
    font-size: clamp(36px, 4.2vw, 52px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--ink);
  }
  .stat__l {
    font-size: 15px;
    color: var(--ink-3);
  }
  @media (max-width: 860px) {
    .payers {
      grid-template-columns: repeat(2, 1fr);
    }
    .payers li {
      height: 60px;
      font-size: 15px;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
      gap: 32px 20px;
    }
  }
</style>
