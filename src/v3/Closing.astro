---
import Logo from '../components/Logo.astro';
import Icon from './Icon.astro';
import { site } from '../site';

const faqs = [
  {
    q: 'What does BatchRx actually do?',
    a: 'BatchRx reconciles the medication you purchase from wholesalers against the claims you bill to each PBM, flags discrepancies like shortages and aberrant claims, and organizes the documents auditors request. When an audit arrives, a dedicated BatchRx specialist helps you through it one-on-one.',
  },
  {
    q: 'Which pharmacy systems and wholesalers do you support?',
    a: 'All major pharmacy management systems, including PrimeRx, Pioneer, Datascan, DigitalRx, BestRx and Liberty, and all primary and secondary wholesalers, including Kinray, McKesson, AmerisourceBergen, Real Value, TopRx, Alpine Health, AXIA and many more.',
  },
  {
    q: 'What kinds of audits do you help with?',
    a: 'Desktop, onsite, CMS and investigative audits, plus the inventory (invoice) reconciliation PBMs use to find shortages. One-on-one assistance with every audit is included in your plan.',
  },
  {
    q: 'How much does it cost?',
    a: 'One plan at $350 per month, with every report, every audit tool and dedicated one-on-one audit assistance. Billed monthly, no setup fees, cancel anytime.',
  },
  {
    q: 'Is my pharmacy’s data secure?',
    a: 'Yes. BatchRx is HIPAA compliant and built to protect patient health information.',
  },
  {
    q: 'I own several pharmacies. Can I manage them together?',
    a: 'Yes. Multi-store owners can oversee every location’s reports and audits from one screen.',
  },
  {
    q: 'Where do you operate?',
    a: 'BatchRx serves independent and multi-store pharmacies in all 50 states.',
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const year = new Date().getFullYear();
---

<section class="sec faq" id="faq" aria-labelledby="faq-h">
  <div class="wrap faq__grid">
    <div class="faq__head">
      <span class="eyebrow rv"><Icon name="message" /> FAQ</span>
      <h2 id="faq-h" class="h2 rv" style="--d:.05s">Frequently asked questions</h2>
      <p class="lead rv" style="--d:.1s">Can't find your answer? <a href="#demo">Book a demo</a> and ask our team directly.</p>
    </div>
    <div class="faq__list rv">
      {
        faqs.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              {f.q}
              <span class="pm" aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<section class="cta" id="demo" aria-labelledby="cta-h">
  <div class="wrap">
    <div class="panel">
      <div class="panel__copy">
        <span class="eyebrow eyebrow--d"><Icon name="calendar" /> Book a demo</span>
        <h2 id="cta-h" class="h2">Ready to know more?</h2>
        <p>
          See BatchRx with a member of our team. We'll show you where pharmacies like yours find discrepancies, and how
          we'd support you through your next audit.
        </p>
        <ul>
          <li><Icon name="check" size={16} stroke={2.2} /> Live walkthrough with our team</li>
          <li><Icon name="check" size={16} stroke={2.2} /> $350/month · no setup fees · cancel anytime</li>
          <li><Icon name="check" size={16} stroke={2.2} /> HIPAA compliant</li>
        </ul>
      </div>

      <form class="form" data-form data-endpoint={site.demoEndpoint ?? ''} novalidate>
        <h3>Request a demo</h3>
        <div class="fields">
          <label><span>Pharmacy name</span><input name="pharmacyName" required autocomplete="organization" placeholder="Main St. Pharmacy" /></label>
          <label><span>Your name</span><input name="contactName" required autocomplete="name" placeholder="Jane Smith" /></label>
          <label><span>Work email</span><input name="email" type="email" required autocomplete="email" placeholder="jane@pharmacy.com" /></label>
          <label><span>Phone</span><input name="phone" type="tel" required autocomplete="tel" placeholder="(555) 000-0000" /></label>
          <label class="full"><span>Pharmacy address</span><input name="pharmacyAddress" required autocomplete="street-address" placeholder="Street, city, state" /></label>
        </div>
        <button class="btn btn--primary btn--lg" type="submit">Request my demo <Icon name="arrow" /></button>
        <p class="msg" role="status" aria-live="polite"></p>
        <p class="fine">We'll only use your details to contact you about BatchRx.</p>
      </form>
    </div>
  </div>
</section>

<footer class="ft">
  <div class="wrap">
    <div class="ft__top">
      <div class="ft__brand">
        <Logo />
        <p>Pharmacy audit software, with a dedicated specialist for every audit.</p>
        <div class="ft__badges">
          <span><Icon name="lock" size={14} /> HIPAA compliant</span>
          <span><Icon name="map" size={14} /> All 50 states</span>
        </div>
      </div>
      <nav class="ft__cols" aria-label="Footer">
        <div>
          <h3>Product</h3>
          <a href="#product">Platform</a>
          <a href="#how">How it works</a>
          <a href="#support">Audit support</a>
          <a href="#pricing">Pricing</a>
        </div>
        <div>
          <h3>Company</h3>
          <a href="#demo">Book a demo</a>
          <a href="#faq">FAQ</a>
          <a href={site.loginUrl}>Log in</a>
        </div>
        <div>
          <h3>Legal</h3>
          <a href={`${site.appUrl}/privacy-policy`}>Privacy Policy</a>
          <a href={`${site.appUrl}/terms-of-service`}>Terms of Service</a>
        </div>
      </nav>
    </div>
    <div class="ft__bot">
      <span>© {year} BatchRx. All rights reserved.</span>
      <span>Pharmacy audits, simplified.</span>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    const msg = form.querySelector<HTMLElement>('.msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.classList.add('checked');
      if (!form.checkValidity()) {
        msg.textContent = 'Please fill in every field.';
        msg.dataset.t = 'err';
        form.querySelector<HTMLInputElement>(':invalid')?.focus();
        return;
      }
      const url = form.dataset.endpoint;
      if (!url) {
        msg.textContent = 'The demo form isn’t connected yet. Set PUBLIC_DEMO_ENDPOINT to enable it.';
        msg.dataset.t = 'err';
        return;
      }
      btn.disabled = true;
      msg.textContent = 'Sending…';
      msg.dataset.t = '';
      try {
        const r = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        form.classList.remove('checked');
        msg.textContent = 'Thank you! Our team will be in touch shortly.';
        msg.dataset.t = 'ok';
      } catch {
        msg.textContent = 'Something went wrong. Please try again.';
        msg.dataset.t = 'err';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  /* FAQ */
  .faq__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .faq__head {
    display: grid;
    gap: 16px;
    justify-items: start;
    position: sticky;
    top: 108px;
  }
  .faq__head a {
    color: var(--b-700);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--b-200);
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--b-700);
  }
  .pm {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition:
      transform 0.3s var(--ease),
      background-color 0.2s;
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .pm::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] .pm {
    transform: rotate(45deg);
    background: var(--b-50);
  }
  details p {
    padding: 0 48px 24px 0;
    font-size: 15.5px;
    color: var(--ink-3);
    line-height: 1.65;
  }

  /* CTA */
  .cta {
    padding-bottom: clamp(80px, 10vw, 128px);
  }
  .panel {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding: clamp(28px, 5vw, 64px);
    border-radius: 28px;
    background: var(--b-950);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(600px 400px at 0% 100%, rgba(43, 117, 96, 0.45), transparent 70%),
      radial-gradient(500px 300px at 100% 0%, rgba(43, 117, 96, 0.25), transparent 70%);
  }
  .panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 60% 80% at 0% 50%, #000, transparent 75%);
  }
  .panel__copy {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .eyebrow--d {
    color: var(--b-200);
  }
  .panel .h2 {
    color: #fff;
  }
  .panel__copy p {
    font-size: 17px;
    color: rgba(216, 229, 224, 0.75);
    max-width: 46ch;
  }
  .panel__copy ul {
    display: grid;
    gap: 10px;
    margin-top: 6px;
    font-size: 15px;
    color: var(--b-100);
  }
  .panel__copy li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .panel__copy li svg {
    color: #3ad08b;
  }
  .form {
    display: grid;
    gap: 18px;
    padding: clamp(22px, 3vw, 32px);
    border-radius: 18px;
    background: #fff;
    color: var(--ink);
    box-shadow: var(--sh-xl);
  }
  .form h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .full {
    grid-column: 1 / -1;
  }
  label {
    display: grid;
    gap: 6px;
  }
  label span {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-2);
  }
  input {
    height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    border: 0;
    background: #fff;
    box-shadow:
      inset 0 0 0 1px var(--line-2),
      var(--sh-xs);
    font-size: 15px;
    transition: box-shadow 0.15s;
  }
  input::placeholder {
    color: var(--ink-4);
  }
  input:hover {
    box-shadow:
      inset 0 0 0 1px var(--ink-4),
      var(--sh-xs);
  }
  input:focus {
    outline: none;
    box-shadow:
      inset 0 0 0 1.5px var(--b-600),
      0 0 0 4px var(--b-50);
  }
  .checked input:invalid {
    box-shadow:
      inset 0 0 0 1.5px var(--bad),
      0 0 0 4px var(--bad-bg);
  }
  .form .btn {
    width: 100%;
  }
  .form .btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .msg:empty {
    display: none;
  }
  .msg {
    font-size: 14px;
  }
  .msg[data-t='ok'] {
    color: var(--ok);
  }
  .msg[data-t='err'] {
    color: var(--bad);
  }
  .fine {
    margin-top: -6px;
    font-size: 12.5px;
    color: var(--ink-4);
    text-align: center;
  }

  /* Footer */
  .ft {
    border-top: 1px solid var(--line);
    padding-top: 64px;
  }
  .ft__top {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 48px;
    padding-bottom: 48px;
  }
  .ft__brand {
    display: grid;
    gap: 14px;
    justify-items: start;
    align-content: start;
  }
  .ft__brand :global(.word) {
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.04em;
  }
  .ft__brand p {
    font-size: 15px;
    color: var(--ink-3);
    max-width: 32ch;
  }
  .ft__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ft__badges span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .ft__badges svg {
    color: var(--b-600);
  }
  .ft__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .ft__cols div {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .ft__cols h3 {
    font-size: 13.5px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .ft__cols a {
    width: fit-content;
    font-size: 14.5px;
    color: var(--ink-3);
    transition: color 0.15s;
  }
  .ft__cols a:hover {
    color: var(--ink);
  }
  .ft__bot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 24px 32px;
    border-top: 1px solid var(--line);
    font-size: 13.5px;
    color: var(--ink-4);
  }

  @media (max-width: 960px) {
    .faq__grid,
    .panel,
    .ft__top {
      grid-template-columns: 1fr;
    }
    .faq__head {
      position: static;
    }
    details p {
      padding-right: 0;
    }
  }
  @media (max-width: 520px) {
    .fields {
      grid-template-columns: 1fr;
    }
    .ft__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
